Dialogue: 0,0:01:17.62,0:01:19.78,Default,,0,0,0,,Tôi luôn tìm kiếm.
Dialogue: 0,0:01:30.46,0:01:31.80,Default,,0,0,0,,Luôn tìm kiếm.
Dialogue: 0,0:01:41.64,0:01:44.14,Default,,0,0,0,,Không trúng. Lại tảo biển.
Dialogue: 0,0:01:44.68,0:01:46.14,Default,,0,0,0,,Hôm nay tất cả là tảo biển.
Dialogue: 0,0:01:46.69,0:01:47.98,Default,,0,0,0,,Tại sao, Akane?
Dialogue: 0,0:01:48.06,0:01:50.73,Default,,0,0,0,,Đã nói bao nhiêu lần là tớ muốn mayonaise và cá ngừ rồi!
Dialogue: 0,0:01:50.73,0:01:52.82,Default,,0,0,0,,Tảo biển ngon mà.\N Nghe chưa?
Dialogue: 0,0:01:52.82,0:01:54.32,Default,,0,0,0,,Cậu thua rồi nhé, Aoi.
Dialogue: 0,0:01:54.82,0:01:56.61,Default,,0,0,0,,Thua cả triệu lần.
Dialogue: 0,0:01:58.78,0:01:59.95,Default,,0,0,0,,Im đi.
Dialogue: 0,0:02:00.20,0:02:01.74,Default,,0,0,0,,Luyện tập thôi.
Dialogue: 0,0:02:02.79,0:02:04.75,Default,,0,0,0,,Nhưng tớ vẫn đang ăn mà.
Dialogue: 0,0:02:04.83,0:02:06.08,Default,,0,0,0,,Ăn nhanh lên!
Dialogue: 0,0:02:06.16,0:02:08.71,Default,,0,0,0,,"Akane Special" của tớ sẽ gầm lên.
Dialogue: 0,0:02:08.79,0:02:10.29,Default,,0,0,0,,Cái tên gớm quá.
Dialogue: 0,0:02:11.54,0:02:12.67,Default,,0,0,0,,Em.
Dialogue: 0,0:02:13.71,0:02:14.92,Default,,0,0,0,,Em cũng muốn chơi.
Dialogue: 0,0:02:16.05,0:02:18.18,Default,,0,0,0,,Vậy anh dạy em guitar nhé?
Dialogue: 0,0:02:21.55,0:02:23.26,Default,,0,0,0,,Vậy em muốn chơi gì?
Dialogue: 0,0:02:27.85,0:02:29.65,Default,,0,0,0,,Hả, đùa à?
Dialogue: 0,0:02:29.73,0:02:32.94,Default,,0,0,0,,Em ngưỡng mộ anh hay có ý gì hả, Aoi?
Dialogue: 0,0:02:33.02,0:02:33.98,Default,,0,0,0,,Không!
Dialogue: 0,0:02:34.28,0:02:35.69,Default,,0,0,0,,Thật à?
Dialogue: 0,0:02:36.19,0:02:39.32,Default,,0,0,0,,Nghĩ lại thì sẽ ngầu lắm nếu con gái chơi bass.
Dialogue: 0,0:02:39.91,0:02:43.49,Default,,0,0,0,,Vậy khi nào lớn thì em sẽ chơi bass cho nhóm của anh.
Dialogue: 0,0:02:43.58,0:02:45.37,Default,,0,0,0,,Thế còn tao?
Dialogue: 0,0:02:45.45,0:02:47.08,Default,,0,0,0,,Tốt rồi nhé, Aoi.
Dialogue: 0,0:02:47.16,0:02:48.83,Default,,0,0,0,,Abo, mày chơi điệp khúc đi.
Dialogue: 0,0:02:49.96,0:02:52.04,Default,,0,0,0,,Không thì làm dancer cũng được.
Dialogue: 0,0:02:52.13,0:02:53.63,Default,,0,0,0,,Này nhé Banba.
Dialogue: 0,0:02:53.71,0:02:55.71,Default,,0,0,0,,Thôi nào, luyện tập thôi.
Dialogue: 0,0:02:55.96,0:02:57.22,Default,,0,0,0,,Bắt đầu bằng bài gì đây?
Dialogue: 0,0:03:00.72,0:03:01.34,Default,,0,0,0,,Akane thì sao??
Dialogue: 0,0:03:01.93,0:03:02.72,Default,,0,0,0,,Bài mọi khi.
Dialogue: 0,0:03:03.18,0:03:04.06,Default,,0,0,0,,Rồi!
Dialogue: 0,0:03:04.14,0:03:05.22,Default,,0,0,0,,Lại nữa?
Dialogue: 0,0:03:05.31,0:03:06.89,Default,,0,0,0,,Lên nào, Michinko!
Dialogue: 0,0:03:07.14,0:03:07.89,Default,,0,0,0,,Rồi, rồi.
Dialogue: 0,0:03:08.31,0:03:09.56,Default,,0,0,0,,Khoan đã!
Dialogue: 0,0:03:09.89,0:03:10.90,Default,,0,0,0,,Thôi nào!
Dialogue: 0,0:03:16.61,0:03:18.03,Default,,0,0,0,,Nếu có thể đến đó.
Dialogue: 0,0:03:25.41,0:03:27.95,Default,,0,0,0,,♪ Nếu có thể đến đó ♪
Dialogue: 0,0:03:28.04,0:03:35.50,Default,,0,0,0,,♪ giấc mơ của bạn sẽ thành hiện thực ♪
Dialogue: 0,0:03:36.38,0:03:41.68,Default,,0,0,0,,♪ Mọi người đều muốn đến ♪
Dialogue: 0,0:03:41.76,0:03:46.10,Default,,0,0,0,,♪ Nhưng đó là một nơi rất xa ♪
Dialogue: 0,0:03:46.56,0:03:49.52,Default,,0,0,0,,♪ Quốc gia đó là Gandhara ♪
Dialogue: 0,0:03:49.52,0:03:51.98,Default,,0,0,0,,♪ Là một nơi đâu đó ngoài kia ♪
Dialogue: 0,0:03:53.10,0:03:54.02,Default,,0,0,0,,Nhưng
Dialogue: 0,0:03:55.44,0:03:57.28,Default,,0,0,0,,nơi đó nhất định
Dialogue: 0,0:04:00.03,0:04:02.57,Default,,0,0,0,,rất xa.
Dialogue: 0,0:04:02.57,0:04:04.16,Default,,0,0,0,,Nghe nói họ bị tai nạn.
Dialogue: 0,0:04:04.16,0:04:06.08,Default,,0,0,0,,Cả hai đi cùng nhau.
Dialogue: 0,0:04:06.08,0:04:08.75,Default,,0,0,0,,Nghe nói không nhìn đường.
Dialogue: 0,0:04:08.75,0:04:11.75,Default,,0,0,0,,Thật tàn nhẫn, ra đi để lại hai đứa con gái.
Dialogue: 0,0:04:12.29,0:04:14.79,Default,,0,0,0,,Akane là học sinh năm 3 cao trung nhỉ?
Dialogue: 0,0:04:15.29,0:04:16.71,Default,,0,0,0,,Con bé sẽ làm gì đây?
Dialogue: 0,0:04:17.63,0:04:20.88,Default,,0,0,0,,Aoi, hãy nghe lời chị nhé.
Dialogue: 0,0:04:21.63,0:04:24.64,Default,,0,0,0,,Từ giờ, hai đứa sẽ phải cố hết sức.
Dialogue: 0,0:04:38.69,0:04:40.28,Default,,0,0,0,,Mình không thể đến đó.
Dialogue: 0,0:04:43.49,0:04:45.49,Default,,0,0,0,,Tại sao? Ý em là sao?
Dialogue: 0,0:04:45.78,0:04:47.83,Default,,0,0,0,,Chúng ta đã hứa sẽ cùng nhau học\N tại một trường nghề ở Tokyo mà?
Dialogue: 0,0:04:52.21,0:04:53.12,Default,,0,0,0,,Akane!
Dialogue: 0,0:04:55.50,0:04:57.92,Default,,0,0,0,,Đừng có bắt nạt Akane, đồ ngốc!
Dialogue: 0,0:04:58.00,0:04:59.25,Default,,0,0,0,,Aoi.
Dialogue: 0,0:04:59.34,0:05:01.67,Default,,0,0,0,,Đừng có dẫn Akane khỏi tôi, đồ ngốc!
Dialogue: 0,0:05:02.05,0:05:02.67,Default,,0,0,0,,Con heo!
Dialogue: 0,0:05:02.80,0:05:05.34,Default,,0,0,0,,Heo? Mỡ của anh có 7% thôi đó!
Dialogue: 0,0:05:05.47,0:05:06.76,Default,,0,0,0,,Im đi, con heo!\N Này, Aoi.
Dialogue: 0,0:05:06.84,0:05:09.81,Default,,0,0,0,,Khỉ! Tinh tinh! Đừng có dẫn Akane theo!
Dialogue: 0,0:05:09.89,0:05:12.68,Default,,0,0,0,,Akane và Aoi sẽ ở cùng nhau!
Dialogue: 0,0:05:22.07,0:05:25.86,Default,,0,0,0,,Mình vẫn đang tìm kiếm.
Dialogue: 0,0:05:35.21,0:05:36.79,Default,,0,0,0,,Từ Akane: Về nhà thôi
Dialogue: 0,0:06:04.49,0:06:05.40,Default,,0,0,0,,28 tháng 10
Dialogue: 0,0:06:24.46,0:06:25.55,Default,,0,0,0,,Mình vẫn đang tìm kiếm nó.
Dialogue: 0,0:06:33.31,0:06:36.89,Default,,0,0,0,,Một nơi biến giấc mơ thành hiện thực.
Dialogue: 0,0:06:49.78,0:06:51.20,Default,,0,0,0,,Em sẽ đi Tokyo.
Dialogue: 0,0:06:51.28,0:06:55.62,Default,,0,0,0,,Thầy hiểu nhưng không phải em đi để học nhỉ?
Dialogue: 0,0:06:55.79,0:06:56.91,Default,,0,0,0,,Làm việc hả?
Dialogue: 0,0:06:57.41,0:07:00.04,Default,,0,0,0,,Em làm bán thời gian trong khi chờ ban nhạc nổi tiếng.
Dialogue: 0,0:07:00.12,0:07:02.54,Default,,0,0,0,,Ban nhạc à. Thành viên đâu?
Dialogue: 0,0:07:02.63,0:07:04.13,Default,,0,0,0,,Chỉ mình em.
Dialogue: 0,0:07:04.92,0:07:09.38,Default,,0,0,0,,Thầy sẽ ghi "đi làm" nhé. Rồi, Ootaki vào đi.
Dialogue: 0,0:07:09.38,0:07:10.76,Default,,0,0,0,,Vâng.
Dialogue: 0,0:07:12.93,0:07:14.39,Default,,0,0,0,,Có vẻ đang bực.
Dialogue: 0,0:07:14.39,0:07:15.78,Default,,0,0,0,,Ootaki! Nhanh lên!
Dialogue: 0,0:07:15.80,0:07:18.48,Default,,0,0,0,,Em sẽ làm cô dâu!
Dialogue: 0,0:07:18.48,0:07:20.86,Default,,0,0,0,,Em không biết đối phương là ai nhưng-
Dialogue: 0,0:07:20.94,0:07:21.98,Default,,0,0,0,,Đi làm việc đi.
Dialogue: 0,0:07:22.48,0:07:23.48,Default,,0,0,0,,Tiếp theo.
Dialogue: 0,0:07:32.62,0:07:36.83,Default,,0,0,0,,Cuối năm Uỷ Ban bận rộn lắm.
Dialogue: 0,0:07:37.16,0:07:39.29,Default,,0,0,0,,Tháng sau chắc không đón em được rồi.
Dialogue: 0,0:07:40.50,0:07:44.84,Default,,0,0,0,,Từ nhà chúng ta đến trường mất tới 1 tiếng.
Dialogue: 0,0:07:45.13,0:07:46.80,Default,,0,0,0,,Thời tiết đẹp mà.
Dialogue: 0,0:07:46.88,0:07:49.84,Default,,0,0,0,,Em có thể ngắm lá mùa thu khi đi bộ trên núi.
Dialogue: 0,0:07:51.72,0:07:53.51,Default,,0,0,0,,Em ghét núi.
Dialogue: 0,0:07:54.97,0:07:59.68,Default,,0,0,0,,Khi sống trong thung lũng cảm giác như bị bao quanh bởi bốn bức tường.
Dialogue: 0,0:08:00.52,0:08:04.31,Default,,0,0,0,,Chúng ta đang bị giam cầm \Ntrong một nhà tù khổng lồ.
Dialogue: 0,0:08:04.40,0:08:06.69,Default,,0,0,0,,Ra rồi! Lời nhạc của Aoi.
Dialogue: 0,0:08:06.82,0:08:08.48,Default,,0,0,0,,Kệ em.
Dialogue: 0,0:08:08.57,0:08:11.65,Default,,0,0,0,,Tóm lại là em sẽ rời khỏi đây.
Dialogue: 0,0:08:25.46,0:08:26.50,Default,,0,0,0,,Ủa?
Dialogue: 0,0:08:30.84,0:08:31.84,Default,,0,0,0,,Xin chào!
Dialogue: 0,0:08:33.22,0:08:35.80,Default,,0,0,0,,Chào mừng trở về, Akane, Aoi.
Dialogue: 0,0:08:35.89,0:08:37.22,Default,,0,0,0,,Mọi người làm gì vậy?
Dialogue: 0,0:08:37.35,0:08:38.89,Default,,0,0,0,,Buổi gặp nhau tối nay.
Dialogue: 0,0:08:39.02,0:08:41.43,Default,,0,0,0,,Masamichi mời nhiều người lắm
Dialogue: 0,0:08:44.39,0:08:48.02,Default,,0,0,0,,Em sẽ giúp nữa! Ra đây nào Aoi!
Dialogue: 0,0:08:51.57,0:08:53.65,Default,,0,0,0,,Xin lỗi nhé. Mấy em đang về nhà mà.
Dialogue: 0,0:08:53.74,0:08:56.74,Default,,0,0,0,,Không sao. Bọn em cũng sẽ tham gia gặp mặt mà.
Dialogue: 0,0:08:57.12,0:08:59.29,Default,,0,0,0,,Akane này, có thích ăn lê không?
Dialogue: 0,0:08:59.37,0:09:00.91,Default,,0,0,0,,Vâng, em ăn!
Dialogue: 0,0:09:01.00,0:09:03.08,Default,,0,0,0,,Chị cháu tuyệt thật nhỉ.
Dialogue: 0,0:09:03.37,0:09:05.25,Default,,0,0,0,,Phải biết ơn chị mình nhé, Aoi.
Dialogue: 0,0:09:05.96,0:09:12.26,Default,,0,0,0,,Mỗi lần nghe "phải biết ơn" \Nlà mình chỉ muốn nổi loạn.
Dialogue: 0,0:09:14.22,0:09:20.14,Default,,0,0,0,,Súp miso khoai tây nên có nhiều vị khác nhau.
Dialogue: 0,0:09:20.22,0:09:23.39,Default,,0,0,0,,Như miso với yuzu hay với ớt cay.
Dialogue: 0,0:09:23.48,0:09:26.65,Default,,0,0,0,,Nhưng khách sẽ kéo đến chỉ vì mấy thứ này chứ?
Dialogue: 0,0:09:26.73,0:09:29.48,Default,,0,0,0,,Sao ông bi quan thế?
Dialogue: 0,0:09:29.57,0:09:33.99,Default,,0,0,0,,Thành phố này đã kéo gần như tất cả\N khách du lịch trong khu vực còn gì.
Dialogue: 0,0:09:34.07,0:09:37.78,Default,,0,0,0,,Từ giờ, chúng ta cần phải nắm lấy cơ hội!
Dialogue: 0,0:09:37.78,0:09:40.70,Default,,0,0,0,,Phải! Chúng ta đang vươn \Nra biển lớn, cần tận dụng!
Dialogue: 0,0:09:40.70,0:09:44.71,Default,,0,0,0,,Sau cùng thì Cục Du lịch Masamichi đã tài trợ cho chúng ta mà!
Dialogue: 0,0:09:44.71,0:09:45.79,Default,,0,0,0,,Phải phải!
Dialogue: 0,0:09:45.79,0:09:50.34,Default,,0,0,0,,Thậm chí ở Ủy ban, có tin đồn anh ấy đã đi đêm khá nhiều đó.
Dialogue: 0,0:09:50.34,0:09:51.75,Default,,0,0,0,,Đừng có đồn vớ vẩn, Akane!
Dialogue: 0,0:10:02.35,0:10:04.31,Default,,0,0,0,,Sao không tham gia, Ao?
Dialogue: 0,0:10:06.31,0:10:10.77,Default,,0,0,0,,Nếu nó được sử dụng trong dự án đổi mới thị trấn thì đó không còn là âm nhạc nữa.
Dialogue: 0,0:10:11.11,0:10:12.94,Default,,0,0,0,,Không thể tận hưởng âm nhạc.
Dialogue: 0,0:10:13.03,0:10:16.32,Default,,0,0,0,,Thay vì âm nhạc đi vào tai thì nó sẽ đi vào mắt.
Dialogue: 0,0:10:17.20,0:10:21.78,Default,,0,0,0,,Thoạt nghe thì có vẻ thông thái nhưng thực ra khá ngu.
Dialogue: 0,0:10:22.66,0:10:23.70,Default,,0,0,0,,Đau đau đau!
Dialogue: 0,0:10:23.79,0:10:28.00,Default,,0,0,0,,Tóm lại là thị trấn này sẽ dùng âm nhạc để tái sinh!
Dialogue: 0,0:10:33.84,0:10:35.63,Default,,0,0,0,,Aoi! Tsugu!
Dialogue: 0,0:10:36.72,0:10:37.68,Default,,0,0,0,,Ba.
Dialogue: 0,0:10:39.05,0:10:43.31,Default,,0,0,0,,Hai đứa lại đến sảnh chờ luyện tập à?
Dialogue: 0,0:10:43.39,0:10:44.14,Default,,0,0,0,,Vâng.
Dialogue: 0,0:10:44.22,0:10:45.68,Default,,0,0,0,,Đến 9 giờ thôi đó.
Dialogue: 0,0:10:45.68,0:10:49.85,Default,,0,0,0,,Bass của em vang lên nghe khá là ghê rợn.
Dialogue: 0,0:10:52.98,0:10:55.36,Default,,0,0,0,,Nhà anh có phòng cách âm đó...
Dialogue: 0,0:10:57.32,0:10:59.36,Default,,0,0,0,,Em muốn có anh trai không?
Dialogue: 0,0:11:00.99,0:11:03.33,Default,,0,0,0,,Ba, bình tĩnh lại.
Dialogue: 0,0:11:03.41,0:11:05.70,Default,,0,0,0,,Em sẽ không để chị ấy cưới ai đã ly hôn đâu.
Dialogue: 0,0:11:05.70,0:11:10.25,Default,,0,0,0,,Anh là nạn nhân! Vợ cũ đã lừa anh!
Dialogue: 0,0:11:10.25,0:11:11.54,Default,,0,0,0,,Ai thèm quan tâm.
Dialogue: 0,0:11:12.33,0:11:14.00,Default,,0,0,0,,Này, Aoi!
Dialogue: 0,0:11:15.34,0:11:17.72,Default,,0,0,0,,Em có nhớ Shinno không?
Dialogue: 0,0:11:19.68,0:11:21.59,Default,,0,0,0,,Ừm, có.
Dialogue: 0,0:11:21.68,0:11:22.39,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:11:22.51,0:11:25.68,Default,,0,0,0,,Nếu em không nhớ thì không sao.
Dialogue: 0,0:11:37.53,0:11:43.24,Default,,0,0,0,,Hẳn là lỗi tại tôi
Dialogue: 0,0:11:45.37,0:11:47.20,Default,,0,0,0,,Những gì ba em nói vừa nãy.
Dialogue: 0,0:11:50.12,0:11:52.37,Default,,0,0,0,,Em cũng không tán thành.
Dialogue: 0,0:11:52.92,0:11:55.46,Default,,0,0,0,,Nhưng mà, ông ấy cũng.
Dialogue: 0,0:11:55.54,0:11:58.21,Default,,0,0,0,,Đừng có nói chuyện ở đây.
Dialogue: 0,0:11:58.71,0:12:00.72,Default,,0,0,0,,Vậy không ở đây thì được à?
Dialogue: 0,0:12:02.72,0:12:04.22,Default,,0,0,0,,Không phải không được.
Dialogue: 0,0:12:05.05,0:12:07.43,Default,,0,0,0,,nhưng mà ở đây.
Dialogue: 0,0:12:08.56,0:12:09.60,Default,,0,0,0,,Sai rồi.
Dialogue: 0,0:12:09.89,0:12:12.35,Default,,0,0,0,,Nào, phải cầm chắc hơn.
Dialogue: 0,0:12:14.15,0:12:19.44,Default,,0,0,0,,Ao, em có nốt ruồi trong tròng trắng à?
Dialogue: 0,0:12:20.07,0:12:22.28,Default,,0,0,0,,Giống anh.
Dialogue: 0,0:12:22.91,0:12:25.53,Default,,0,0,0,,Nốt ruồi trong mắt là dấu hiệu\N cho thấy chúng ta sẽ thành công đó!
Dialogue: 0,0:12:25.62,0:12:28.24,Default,,0,0,0,,Chúng ta là ngôi sao tròng mắt!
Dialogue: 0,0:12:28.95,0:12:30.29,Default,,0,0,0,,Ngôi sao tròng mắt!
Dialogue: 0,0:12:31.12,0:12:34.38,Default,,0,0,0,,Cái tên gì vậy? Chẳng ai hiểu đâu.
Dialogue: 0,0:12:34.46,0:12:36.63,Default,,0,0,0,,Hả? Nghe ngầu mà!
Dialogue: 0,0:12:36.79,0:12:37.96,Default,,0,0,0,,Ngầu!
Dialogue: 0,0:12:49.60,0:12:53.56,Default,,0,0,0,,Nitobe Daikichi là người đã tham gia cuộc thi chương trình năm mới trên TV nhỉ?
Dialogue: 0,0:12:53.64,0:12:55.81,Default,,0,0,0,,À, nhớ ra rồi.
Dialogue: 0,0:12:56.27,0:12:58.73,Default,,0,0,0,,Ông ta ngồi trên một ngôi đền di động kì lạ nhỉ.
Dialogue: 0,0:12:58.82,0:13:01.57,Default,,0,0,0,,À, tớ cũng xem rồi.
Dialogue: 0,0:13:01.57,0:13:05.61,Default,,0,0,0,,Chúng ta đã yêu cầu ông ta \Nviết một bài hát cho sự kiện này.
Dialogue: 0,0:13:05.99,0:13:09.12,Default,,0,0,0,,Sẽ có cụm từ "Pháo hoa nổ "bùm bùm" trong lời nhạc
Dialogue: 0,0:13:09.20,0:13:12.25,Default,,0,0,0,,và khoảnh khắc hát nó sẽ bắn pháo hoa thật!
Dialogue: 0,0:13:12.33,0:13:13.41,Default,,0,0,0,,Pháo hoa? Ghê vậy.
Dialogue: 0,0:13:13.50,0:13:15.75,Default,,0,0,0,,Quả nhiên anh đã lo lót khá nhiều nhỉ.
Dialogue: 0,0:13:15.83,0:13:24.17,Default,,0,0,0,,Đây là, kiệt tác của tôi. Đặt cả cuộc đời vào nó.
Dialogue: 0,0:13:26.18,0:13:29.68,Default,,0,0,0,,Thế nên hi vọng em cũng giúp cho sự kiện lần này, Akane.
Dialogue: 0,0:13:30.68,0:13:33.52,Default,,0,0,0,,Anh đã nói chuyện với Cục Cư dân.
Dialogue: 0,0:13:33.68,0:13:36.40,Default,,0,0,0,,Nghe rồi đó. Cố lên nhé, Aioi.
Dialogue: 0,0:13:36.48,0:13:37.19,Default,,0,0,0,,Khoan đã!
Dialogue: 0,0:13:37.35,0:13:39.36,Default,,0,0,0,,Nakamura, cuộc họp bắt đầu rồi.
Dialogue: 0,0:13:40.19,0:13:42.65,Default,,0,0,0,,Chút nữa anh nói chi tiết sau.
Dialogue: 0,0:13:42.74,0:13:44.36,Default,,0,0,0,,Khoan đã, Michinko!
Dialogue: 0,0:13:44.70,0:13:49.37,Default,,0,0,0,,Bên chúng ta cũng không bận rộn\N lắm nên là cố lên nhé.
Dialogue: 0,0:13:54.91,0:13:58.71,Default,,0,0,0,,Chị biết anh Michinko thích chị nhỉ?
Dialogue: 0,0:14:00.09,0:14:01.38,Default,,0,0,0,,À thì.
Dialogue: 0,0:14:01.88,0:14:04.55,Default,,0,0,0,,Đừng để anh ta dụ đó.
Dialogue: 0,0:14:10.18,0:14:13.56,Default,,0,0,0,,Anh ấy là bạn cũ và làm cùng chỗ với chị.
Dialogue: 0,0:14:13.97,0:14:16.44,Default,,0,0,0,,Dù chị biết anh ấy có cảm xúc đó với chị,
Dialogue: 0,0:14:16.52,0:14:18.73,Default,,0,0,0,,thì có những chuyện không nên nói ra.
Dialogue: 0,0:14:19.23,0:14:21.40,Default,,0,0,0,,Đó là hành xử của người lớn.
Dialogue: 0,0:14:22.65,0:14:25.24,Default,,0,0,0,,Người lớn thật tẻ nhạt.
Dialogue: 0,0:14:27.20,0:14:28.45,Default,,0,0,0,,Quan trọng hơn.
Dialogue: 0,0:14:29.78,0:14:32.33,Default,,0,0,0,,Sao em không nghĩ lại chuyện đó?
Dialogue: 0,0:14:33.12,0:14:34.50,Default,,0,0,0,,Đại học.
Dialogue: 0,0:14:35.29,0:14:38.21,Default,,0,0,0,,Em có thể vừa học vừa chơi cho ban nhạc.
Dialogue: 0,0:14:38.29,0:14:40.67,Default,,0,0,0,,Chúng ta đã quyết định rồi mà?
Dialogue: 0,0:14:41.09,0:14:44.00,Default,,0,0,0,,Chị đã hứa sẽ không làm phiền em vụ đó nữa mà.
Dialogue: 0,0:14:45.76,0:14:48.68,Default,,0,0,0,,Đừng phá vỡ lời hứa.
Dialogue: 0,0:14:52.30,0:14:54.01,Default,,0,0,0,,Vậy em đi luyện tập.
Dialogue: 0,0:16:00.16,0:16:01.42,Default,,0,0,0,,Ồn quá đi!
Dialogue: 0,0:16:01.71,0:16:03.58,Default,,0,0,0,,Cái quái gì thế?
Dialogue: 0,0:16:03.71,0:16:06.25,Default,,0,0,0,,Nhịp điệu và canh nhạc của em gớm quá.
Dialogue: 0,0:16:12.51,0:16:13.26,Default,,0,0,0,,Ai thế?
Dialogue: 0,0:16:17.76,0:16:18.52,Default,,0,0,0,,Này.
Dialogue: 0,0:16:19.22,0:16:21.77,Default,,0,0,0,,Chúng ta là ngôi sao tròng mắt!
Dialogue: 0,0:16:22.90,0:16:24.94,Default,,0,0,0,,Shin... no?
Dialogue: 0,0:16:25.90,0:16:29.61,Default,,0,0,0,,Em biết anh à? Ủa? Đồng phục trường anh mà.
Dialogue: 0,0:16:30.07,0:16:32.78,Default,,0,0,0,,Là fan của anh à?
Dialogue: 0,0:16:32.86,0:16:34.11,Default,,0,0,0,,Muốn bắt tay không?
Dialogue: 0,0:16:35.28,0:16:36.12,Default,,0,0,0,,Ủa.
Dialogue: 0,0:16:36.83,0:16:38.29,Default,,0,0,0,,Hả? Tại sao.
Dialogue: 0,0:16:43.79,0:16:46.13,Default,,0,0,0,,Anh là Shinno.
Dialogue: 0,0:16:46.25,0:16:48.63,Default,,0,0,0,,Chứ còn ai nữa? Em là ai?
Dialogue: 0,0:16:49.09,0:16:50.13,Default,,0,0,0,,Akane!
Dialogue: 0,0:16:50.26,0:16:52.63,Default,,0,0,0,,Này! Khoan đã!
Dialogue: 0,0:16:53.76,0:16:54.97,Default,,0,0,0,,Khoan đã! Này!
Dialogue: 0,0:16:59.60,0:17:00.81,Default,,0,0,0,,Này, cái gì đây?
Dialogue: 0,0:17:04.44,0:17:06.48,Default,,0,0,0,,Cái quái gì thế này?
Dialogue: 0,0:17:06.94,0:17:09.98,Default,,0,0,0,,Này, thả anh ra!
Dialogue: 0,0:17:17.78,0:17:19.49,Default,,0,0,0,,Akane!
Dialogue: 0,0:17:19.79,0:17:21.70,Default,,0,0,0,,Ủa? Em luyện tập xong rồi à?
Dialogue: 0,0:17:21.79,0:17:23.83,Default,,0,0,0,,Hôm nay chị làm món em thích, thịt băm--
Dialogue: 0,0:17:23.96,0:17:25.17,Default,,0,0,0,,Shinno.
Dialogue: 0,0:17:27.96,0:17:28.84,Default,,0,0,0,,Xin lỗi!
Dialogue: 0,0:17:29.42,0:17:32.01,Default,,0,0,0,,Vậy Shinno thì sao?
Dialogue: 0,0:17:33.97,0:17:38.68,Default,,0,0,0,,À không... Em đang luyện tập thì nghĩ đến anh ấy.
Dialogue: 0,0:17:39.14,0:17:43.52,Default,,0,0,0,,Và đang tự hỏi anh ấy đang làm gì, chỉ thế thôi.
Dialogue: 0,0:17:45.14,0:17:47.85,Default,,0,0,0,,Chị không liên lạc với anh ấy lâu rồi.
Dialogue: 0,0:17:48.48,0:17:51.69,Default,,0,0,0,,Không biết anh ta sống hay chết.
Dialogue: 0,0:17:54.78,0:17:57.53,Default,,0,0,0,,Hiểu rồi. Cũng có thể là vậy.
Dialogue: 0,0:17:57.82,0:17:59.53,Default,,0,0,0,,Cơ mà chắc chắn là thế còn gì!
Dialogue: 0,0:17:59.83,0:18:03.20,Default,,0,0,0,,Vì, anh ấy chẳng khác gì với ngày xưa.
Dialogue: 0,0:18:03.66,0:18:04.54,Default,,0,0,0,,Aoi?
Dialogue: 0,0:18:05.50,0:18:08.08,Default,,0,0,0,,Này, sao để cửa nhà mở toang hoác thế?
Dialogue: 0,0:18:08.17,0:18:09.92,Default,,0,0,0,,Bất cẩn quá.
Dialogue: 0,0:18:10.00,0:18:10.88,Default,,0,0,0,,Michinko?
Dialogue: 0,0:18:11.00,0:18:13.42,Default,,0,0,0,,Hai người đang làm trò gì thế?
Dialogue: 0,0:18:13.51,0:18:15.05,Default,,0,0,0,,Làm gì á? Thì làm bữa tối-
Dialogue: 0,0:18:15.17,0:18:16.68,Default,,0,0,0,,Không phải lúc!
Dialogue: 0,0:18:17.93,0:18:19.55,Default,,0,0,0,,Tôi cần giúp đỡ cho vụ sự kiện!
Dialogue: 0,0:18:19.64,0:18:20.85,Default,,0,0,0,,Nghe rồi nhưng.
Dialogue: 0,0:18:20.93,0:18:23.68,Default,,0,0,0,,Ủa? Tôi quên nói là hôm nay à?
Dialogue: 0,0:18:23.77,0:18:24.64,Default,,0,0,0,,Hôm nay?
Dialogue: 0,0:18:24.73,0:18:27.06,Default,,0,0,0,,Bỏ đi! Chúng ta phải đi thôi!
Dialogue: 0,0:18:29.86,0:18:34.07,Default,,0,0,0,,Khi anh ấy đến hãy giơ cao tay và tỏ ra thật thích thú nhé!
Dialogue: 0,0:18:34.23,0:18:38.03,Default,,0,0,0,,Vậy đây là thứ ba làm tối qua à?
Dialogue: 0,0:18:38.11,0:18:40.41,Default,,0,0,0,,Này, đừng có để rơi miso vào đó.
Dialogue: 0,0:18:40.49,0:18:43.87,Default,,0,0,0,,Thiệt tình, tự nhiên mình ở đây là sao?\N Nhưng sao lại đến hôm nay?
Dialogue: 0,0:18:43.95,0:18:45.62,Default,,0,0,0,,Sự kiện cả tuần nữa cơ mà?
Dialogue: 0,0:18:45.70,0:18:46.71,Default,,0,0,0,,Chuyện là.
Dialogue: 0,0:18:47.04,0:18:50.08,Default,,0,0,0,,Ngài Nitobe là người chịu trách nhiệm cho bài hát, phải chứ?
Dialogue: 0,0:18:50.17,0:18:54.25,Default,,0,0,0,,Và ông ta nói sẽ không thể hát về linh hồn của vùng đất
Dialogue: 0,0:18:54.55,0:18:57.59,Default,,0,0,0,,nếu không tiếp xúc với mọi người và ăn thực phẩm địa phương.
Dialogue: 0,0:18:57.67,0:19:00.14,Default,,0,0,0,,Và Ủy ban trả tiền cho chuyện này nhỉ?
Dialogue: 0,0:19:00.55,0:19:05.22,Default,,0,0,0,,Cái đó hoàn toàn là hối lộ còn gì?
Dialogue: 0,0:19:05.97,0:19:06.93,Default,,0,0,0,,Tsugu?
Dialogue: 0,0:19:17.19,0:19:20.11,Default,,0,0,0,,Xin lỗi vì đã để mọi người chờ lâu.
Dialogue: 0,0:19:20.36,0:19:23.66,Default,,0,0,0,,Người đàn ông lẻ loi, Nitobe Dankichi,
Dialogue: 0,0:19:23.74,0:19:30.37,Default,,0,0,0,,đã băng qua cánh đồng xa và những ngọn núi để mang đến món quà nụ cười.
Dialogue: 0,0:19:30.46,0:19:32.79,Default,,0,0,0,,Mồi nhử?
Dialogue: 0,0:19:36.76,0:19:38.13,Default,,0,0,0,,Akane?
Dialogue: 0,0:19:40.55,0:19:45.14,Default,,0,0,0,,♪ Tôi đã đến, người đàn ông đẹp trai ♪
Dialogue: 0,0:19:45.22,0:19:48.56,Default,,0,0,0,,♪ Mở điện thoại lên và chụp hình đi ♪
Dialogue: 0,0:19:50.19,0:19:52.56,Default,,0,0,0,,Đó, đó là.
Dialogue: 0,0:19:53.19,0:19:54.40,Default,,0,0,0,,Shinno.
Dialogue: 0,0:19:54.73,0:19:57.40,Default,,0,0,0,,Này Tsugu! Giữ chặt vào!
Dialogue: 0,0:20:03.74,0:20:08.50,Default,,0,0,0,,♪ Nhưng tất cả vẫn hoàn thành ♪
Dialogue: 0,0:20:08.58,0:20:13.25,Default,,0,0,0,,♪ Chẳng có gì tốt hơn một liều thuốc nụ cười ♪
Dialogue: 0,0:20:13.54,0:20:17.09,Default,,0,0,0,,♪ Mọi người hãy cười lên nào! ♪
Dialogue: 0,0:20:22.38,0:20:23.59,Default,,0,0,0,,Này Ao!
Dialogue: 0,0:20:23.89,0:20:25.26,Default,,0,0,0,,Thiệt tình.
Dialogue: 0,0:20:32.44,0:20:37.77,Default,,0,0,0,,Ba, mẹ và ông bà tổ tiên, xin hãy cho con sức mạnh!
Dialogue: 0,0:20:38.44,0:20:39.61,Default,,0,0,0,,Thiệt tình.
Dialogue: 0,0:20:41.11,0:20:44.11,Default,,0,0,0,,Ao, bác tài gửi hóa đơn. Em phải.
Dialogue: 0,0:20:48.95,0:20:52.46,Default,,0,0,0,,Người tên Shinno đó thực sự ở đây?
Dialogue: 0,0:20:53.50,0:20:55.71,Default,,0,0,0,,Cứ tưởng là ma,
Dialogue: 0,0:20:55.79,0:21:00.71,Default,,0,0,0,,nhưng chị đã thấy Shinno thực sự ở ga, vậy đây là ai?
Dialogue: 0,0:21:00.71,0:21:02.30,Default,,0,0,0,,Vậy là người giống người?
Dialogue: 0,0:21:02.30,0:21:06.39,Default,,0,0,0,,Chị không biết, nhưng đó cũng là Shinno.
Dialogue: 0,0:21:06.39,0:21:08.97,Default,,0,0,0,,Chị cũng chẳng biết chuyện gì đang xảy ra!
Dialogue: 0,0:21:12.27,0:21:13.14,Default,,0,0,0,,Thế nào?
Dialogue: 0,0:21:14.98,0:21:16.48,Default,,0,0,0,,Chẳng có ai ở đây cả.
Dialogue: 0,0:21:18.11,0:21:19.82,Default,,0,0,0,,Không thể nào...
Dialogue: 0,0:21:21.78,0:21:23.82,Default,,0,0,0,,Sao em lại bỏ chạy?
Dialogue: 0,0:21:26.16,0:21:28.99,Default,,0,0,0,,Ao? T-Thả chị ấy ra!
Dialogue: 0,0:21:30.33,0:21:33.16,Default,,0,0,0,,Nhóc nào đây? Y chang Michinko.
Dialogue: 0,0:21:36.50,0:21:38.08,Default,,0,0,0,,Anh là thứ gì?
Dialogue: 0,0:21:38.17,0:21:39.84,Default,,0,0,0,,Anh là Shinno!
Dialogue: 0,0:21:39.96,0:21:41.71,Default,,0,0,0,,Mấy đứa là ai?
Dialogue: 0,0:21:41.80,0:21:44.01,Default,,0,0,0,,Aoi, chạy thôi.
Dialogue: 0,0:21:44.34,0:21:46.01,Default,,0,0,0,,Ao?
Dialogue: 0,0:21:47.68,0:21:49.14,Default,,0,0,0,,Aioi Aoi.
Dialogue: 0,0:21:49.85,0:21:52.35,Default,,0,0,0,,Ngôi sao tròng mắt số 2.
Dialogue: 0,0:21:59.86,0:22:03.36,Default,,0,0,0,,Ngày đó, Akane đã nói không đi Tokyo.
Dialogue: 0,0:22:06.91,0:22:09.12,Default,,0,0,0,,Anh cảm giác như không thể trở về nhà.
Dialogue: 0,0:22:12.41,0:22:15.29,Default,,0,0,0,,Vì vài lý do anh vào đây để suy nghĩ.
Dialogue: 0,0:22:15.41,0:22:17.96,Default,,0,0,0,,Và khi nhận ra.
Dialogue: 0,0:22:19.25,0:22:20.79,Default,,0,0,0,,thì đã là buổi sáng?
Dialogue: 0,0:22:21.38,0:22:22.34,Default,,0,0,0,,Tại sao lại hỏi?
Dialogue: 0,0:22:22.42,0:22:24.46,Default,,0,0,0,,Anh cũng chẳng hiểu.
Dialogue: 0,0:22:25.42,0:22:30.51,Default,,0,0,0,,Nhưng khi đang mơ màng thì anh đã bị \Nđánh thức bởi tạp âm kinh khủng kia.
Dialogue: 0,0:22:30.51,0:22:31.97,Default,,0,0,0,,Tạp âm?
Dialogue: 0,0:22:33.77,0:22:41.15,Default,,0,0,0,,Anh chỉ như mới thức dậy, nhưng mấy em bảo\N đã 13 năm trôi  qua nên nó thật khó hiểu.
Dialogue: 0,0:22:41.15,0:22:44.03,Default,,0,0,0,,Hiểu rồi. Giống Urashimataro.
Dialogue: 0,0:22:44.03,0:22:46.03,Default,,0,0,0,,Câu chuyện đó.
Dialogue: 0,0:22:46.03,0:22:50.49,Default,,0,0,0,,Nhưng mà dù thời gian có trôi \Nqua thì cũng đành chịu thôi.
Dialogue: 0,0:22:50.78,0:22:52.66,Default,,0,0,0,,Anh chấp nhận dễ dàng thế sao?
Dialogue: 0,0:22:52.95,0:22:57.12,Default,,0,0,0,,Không, anh chấp nhận nó là nhờ hai đứa.
Dialogue: 0,0:22:57.96,0:23:00.38,Default,,0,0,0,,Nhìn thế nào em cũng y như Michinko thu nhỏ.
Dialogue: 0,0:23:00.38,0:23:01.67,Default,,0,0,0,,Đừng có sờ đầu.
Dialogue: 0,0:23:01.67,0:23:05.84,Default,,0,0,0,,Ít nhất anh ấy cũng không phải ma.
Dialogue: 0,0:23:06.09,0:23:09.01,Default,,0,0,0,,Hiểu rồi. Nhưng vậy thì.
Dialogue: 0,0:23:11.43,0:23:12.85,Default,,0,0,0,,Linh hồn sống.
Dialogue: 0,0:23:12.85,0:23:14.18,Default,,0,0,0,,Linh hồn sống?
Dialogue: 0,0:23:14.18,0:23:16.02,Default,,0,0,0,,Thì chuyện đó hay xảy ra mà?
Dialogue: 0,0:23:16.47,0:23:18.73,Default,,0,0,0,,Khi có cảm xúc mạnh mẽ hướng đến ai đó,
Dialogue: 0,0:23:18.73,0:23:21.69,Default,,0,0,0,,linh hồn sinh ra từ cảm xúc sẽ rời bỏ cơ thể.
Dialogue: 0,0:23:21.98,0:23:25.69,Default,,0,0,0,,Chị có biết! Linh hồn đó sẽ nguyền rủa người sống nhỉ!
Dialogue: 0,0:23:26.61,0:23:29.70,Default,,0,0,0,,Vì Shinno bị Akane từ chối nên là.
Dialogue: 0,0:23:29.78,0:23:32.70,Default,,0,0,0,,Có lẽ anh được sinh ra từ những cảm xúc đó.
Dialogue: 0,0:23:32.95,0:23:34.37,Default,,0,0,0,,Mấy đứa nói nhảm gì thế?
Dialogue: 0,0:23:35.16,0:23:39.54,Default,,0,0,0,,Cảm xúc gì chứ? Anh mày đã từ bỏ đâu?
Dialogue: 0,0:23:40.67,0:23:42.88,Default,,0,0,0,,Sau khi suy nghĩ rất nhiều thì anh đã quyết định.
Dialogue: 0,0:23:42.88,0:23:46.25,Default,,0,0,0,,Đầu tiên anh sẽ đi Tokyo và trở thành nghệ sĩ nổi tiếng!
Dialogue: 0,0:23:46.25,0:23:49.76,Default,,0,0,0,,Sau đó anh sẽ quay về tìm Akane!
Dialogue: 0,0:23:49.76,0:23:50.93,Default,,0,0,0,,Sự lạc quan đến đáng thương này là sao?
Dialogue: 0,0:23:50.93,0:23:54.72,Default,,0,0,0,,Nhưng tại sao chuyện này lại xảy ra?
Dialogue: 0,0:23:55.06,0:23:57.43,Default,,0,0,0,,Akane bây giờ 31 nhỉ?
Dialogue: 0,0:23:57.52,0:24:00.06,Default,,0,0,0,,Khoan đã, 31, 30.
Dialogue: 0,0:24:00.52,0:24:02.48,Default,,0,0,0,,Cơ mà Akane vẫn chưa kết hơn nhỉ?
Dialogue: 0,0:24:02.56,0:24:03.77,Default,,0,0,0,,- Ừm.\N - Ngon!
Dialogue: 0,0:24:03.86,0:24:06.48,Default,,0,0,0,,Khoan, anh có nên vui vì điều đó?
Dialogue: 0,0:24:07.11,0:24:08.86,Default,,0,0,0,,Phải nhanh lên.
Dialogue: 0,0:24:08.94,0:24:10.49,Default,,0,0,0,,Anh có muốn gặp chị ấy không?
Dialogue: 0,0:24:10.78,0:24:13.66,Default,,0,0,0,,Bị ngốc à? Sao có thể gặp trong bộ dạng này?
Dialogue: 0,0:24:13.78,0:24:16.03,Default,,0,0,0,,Có nghe anh nói không đó?
Dialogue: 0,0:24:16.12,0:24:17.95,Default,,0,0,0,,Anh sẽ trở thành nghệ sĩ lớn.
Dialogue: 0,0:24:18.04,0:24:21.67,Default,,0,0,0,,Không biết có lớn không nhưng mà cũng làm nghệ sĩ nhỉ?
Dialogue: 0,0:24:22.46,0:24:28.17,Default,,0,0,0,,Phải nhỉ. Anh năm 31 tuổi đã thành nghệ sĩ rồi.
Dialogue: 0,0:24:31.30,0:24:33.68,Default,,0,0,0,,Tuyệt vời!
Dialogue: 0,0:24:33.80,0:24:35.68,Default,,0,0,0,,Anh đi một chút!
Dialogue: 0,0:24:36.59,0:24:37.51,Default,,0,0,0,,Gặp sau!
Dialogue: 0,0:24:45.73,0:24:48.53,Default,,0,0,0,,Đây hẳn là định mệnh.
Dialogue: 0,0:24:48.53,0:24:50.15,Default,,0,0,0,,Tôi cũng đã ngạc nhiên lắm.
Dialogue: 0,0:24:50.15,0:24:54.41,Default,,0,0,0,,Tôi nghĩ ngài là sự lựa chọn tốt nhất cho bài hát của chúng tôi.
Dialogue: 0,0:24:54.41,0:24:57.03,Default,,0,0,0,,Nên đã quay rất nhiều khung cảnh để chuẩn bị cho ngài.
Dialogue: 0,0:24:57.49,0:25:00.37,Default,,0,0,0,,Và không ngờ lại còn gặp bạn cũ trong ban nhạc ngày xưa nữa!
Dialogue: 0,0:25:00.37,0:25:01.37,Default,,0,0,0,,Nhỉ, Shinno?
Dialogue: 0,0:25:01.37,0:25:02.71,Default,,0,0,0,,Đau.
Dialogue: 0,0:25:02.71,0:25:05.96,Default,,0,0,0,,Với Shinnosuke thì đây là màn trình diễn trở về nhà nhỉ.
Dialogue: 0,0:25:06.84,0:25:09.75,Default,,0,0,0,,Tôi sẽ cho cậu solo guitar.
Dialogue: 0,0:25:09.75,0:25:13.38,Default,,0,0,0,,Được đó! Tôi cũng tham gia nữa!
Dialogue: 0,0:25:13.51,0:25:16.51,Default,,0,0,0,,Kèn của cậu chưa có cái hồn.
Dialogue: 0,0:25:16.59,0:25:18.22,Default,,0,0,0,,Linh hồn là cái gì?
Dialogue: 0,0:25:18.30,0:25:21.22,Default,,0,0,0,,Vậy anh nói với Aoi là Shinno quay trở về à?
Dialogue: 0,0:25:22.10,0:25:23.89,Default,,0,0,0,,Em nói gì hả, Akane?
Dialogue: 0,0:25:24.19,0:25:25.02,Default,,0,0,0,,Không.
Dialogue: 0,0:25:25.10,0:25:26.40,Default,,0,0,0,,Chuyện gì thế này?
Dialogue: 0,0:25:26.69,0:25:29.23,Default,,0,0,0,,Hai người hẹn hò à?
Dialogue: 0,0:25:30.03,0:25:32.69,Default,,0,0,0,,À, tôi để ngài tự tưởng tượng.
Dialogue: 0,0:25:32.78,0:25:34.24,Default,,0,0,0,,Này, Michinko.
Dialogue: 0,0:25:34.86,0:25:36.99,Default,,0,0,0,,Sao dở quá vậy?
Dialogue: 0,0:25:37.07,0:25:39.66,Default,,0,0,0,,Gọi món ngon hơn đi! Thêm thịt đi chủ quán!
Dialogue: 0,0:25:42.37,0:25:43.91,Default,,0,0,0,,Vậy là không thể ra khỏi đây à?
Dialogue: 0,0:25:44.21,0:25:46.12,Default,,0,0,0,,Giống như linh hồn bị ràng buộc?
Dialogue: 0,0:25:46.21,0:25:49.13,Default,,0,0,0,,Anh đã biết chuyện đó mà vẫn lao ra?
Dialogue: 0,0:25:51.05,0:25:53.76,Default,,0,0,0,,Vậy là giấc mơ đã thành sự thật.
Dialogue: 0,0:25:55.72,0:25:57.80,Default,,0,0,0,,Lúc đó anh đã nghĩ.
Dialogue: 0,0:25:57.89,0:26:02.97,Default,,0,0,0,,Nhanh chóng tốt nghiệp, lên Tokyo, chạy đua đến tương lai,
Dialogue: 0,0:26:03.06,0:26:05.73,Default,,0,0,0,,và quay trở về đón Akane.
Dialogue: 0,0:26:07.15,0:26:10.44,Default,,0,0,0,,Anh đã hi vọng ngày đó sẽ đến thật nhanh.
Dialogue: 0,0:26:10.90,0:26:16.28,Default,,0,0,0,,Thế nên dù anh là một linh hồn sống nhưng chắc chắn không có hận thù gì cả.
Dialogue: 0,0:26:18.24,0:26:22.45,Default,,0,0,0,,Tóm lại, anh chỉ hiểu một việc.
Dialogue: 0,0:26:22.62,0:26:27.12,Default,,0,0,0,,Nếu tương lai anh và Akane hẹn hò thì mọi chuyện sẽ đi đúng hướng, phải chứ?
Dialogue: 0,0:26:27.79,0:26:32.13,Default,,0,0,0,,Và linh hồn sống này sẽ bùm một cái trở về cơ thể thật.
Dialogue: 0,0:26:33.96,0:26:35.80,Default,,0,0,0,,Nhờ em cả đó, ngôi sao tròng mắt.
Dialogue: 0,0:26:40.47,0:26:42.47,Default,,0,0,0,,Ngày xưa anh ấy toàn thế này à?
Dialogue: 0,0:26:44.43,0:26:45.48,Default,,0,0,0,,Chắc vậy.
Dialogue: 0,0:26:45.81,0:26:48.31,Default,,0,0,0,,Nhưng lúc nhìn thấy có vẻ khá người lớn.
Dialogue: 0,0:26:48.81,0:26:49.81,Default,,0,0,0,,Giờ sao?
Dialogue: 0,0:26:50.81,0:26:54.65,Default,,0,0,0,,Chị sẽ giúp bọn họ đến với nhau à?
Dialogue: 0,0:26:55.65,0:26:57.57,Default,,0,0,0,,Cũng không tệ.
Dialogue: 0,0:26:57.65,0:26:58.74,Default,,0,0,0,,Thật hả?
Dialogue: 0,0:26:58.82,0:27:01.32,Default,,0,0,0,,Tốt hơn là chị Akane.
Dialogue: 0,0:27:03.83,0:27:06.83,Default,,0,0,0,,nên ở với anh ấy hơn chị.
Dialogue: 0,0:27:08.83,0:27:11.17,Default,,0,0,0,,Nào, tăng hai, đi tăng hai.
Dialogue: 0,0:27:11.67,0:27:13.50,Default,,0,0,0,,Vâng, ngay đây ạ.
Dialogue: 0,0:27:13.63,0:27:16.76,Default,,0,0,0,,Này Shinnosuke, muốn ói thì ói vào đây.
Dialogue: 0,0:27:16.84,0:27:18.34,Default,,0,0,0,,Thịt ngon thế mà.
Dialogue: 0,0:27:20.51,0:27:23.35,Default,,0,0,0,,Hết cách rồi.
Dialogue: 0,0:27:23.47,0:27:26.18,Default,,0,0,0,,Tôi không uống nên sẽ đưa anh ấy về.
Dialogue: 0,0:27:26.68,0:27:31.85,Default,,0,0,0,,Masamichi, tôi muốn đến chỗ có gái đẹp, gái khu này đấy nhé.
Dialogue: 0,0:27:32.36,0:27:33.86,Default,,0,0,0,,À vâng!
Dialogue: 0,0:27:50.04,0:27:51.21,Default,,0,0,0,,Gandhara?
Dialogue: 0,0:27:54.04,0:27:54.71,Default,,0,0,0,,Tỉnh rồi hả?
Dialogue: 0,0:27:57.05,0:28:01.22,Default,,0,0,0,,Giấc mơ của anh đã thành hiện thực, nhỉ?
Dialogue: 0,0:28:01.72,0:28:03.72,Default,,0,0,0,,Phải đó.
Dialogue: 0,0:28:04.89,0:28:06.39,Default,,0,0,0,,Em mỉa mai anh à.
Dialogue: 0,0:28:07.22,0:28:11.73,Default,,0,0,0,,Em chỉ ngạc nhiên khi anh trở thành \Nmột tên say xỉn thôi, Shinno.
Dialogue: 0,0:28:12.65,0:28:14.90,Default,,0,0,0,,Em vẫn độc thân nên là
Dialogue: 0,0:28:15.65,0:28:17.40,Default,,0,0,0,,em chờ anh hả?
Dialogue: 0,0:28:19.74,0:28:21.36,Default,,0,0,0,,Có chờ không nhỉ?
Dialogue: 0,0:28:22.36,0:28:23.32,Default,,0,0,0,,Có lẽ.
Dialogue: 0,0:28:23.41,0:28:24.91,Default,,0,0,0,,không phải đâu.
Dialogue: 0,0:28:29.58,0:28:31.08,Default,,0,0,0,,Đến rồi.
Dialogue: 0,0:28:32.08,0:28:36.92,Default,,0,0,0,,Đi thẳng vào đi, em lấy anh ít nước. Uống với anh đi, Aioi.
Dialogue: 0,0:28:37.59,0:28:39.42,Default,,0,0,0,,Đừng có nói mấy điều ngu ngốc nữa.
Dialogue: 0,0:28:40.42,0:28:41.42,Default,,0,0,0,,Này.
Dialogue: 0,0:28:45.09,0:28:46.01,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:28:46.80,0:28:48.01,Default,,0,0,0,,Cái quái gì thế?
Dialogue: 0,0:28:48.60,0:28:51.02,Default,,0,0,0,,Đừng làm thế ở tuổi của em.
Dialogue: 0,0:28:51.10,0:28:52.52,Default,,0,0,0,,Anh nghiêm túc sao?
Dialogue: 0,0:28:53.31,0:28:55.52,Default,,0,0,0,,Có sao đâu? Em có mất gì đâu?
Dialogue: 0,0:28:56.48,0:28:59.69,Default,,0,0,0,,Đó là điều anh nói khi gặp nhau sau 13 năm à?
Dialogue: 0,0:29:01.95,0:29:03.45,Default,,0,0,0,,Đừng làm em thất vọng.
Dialogue: 0,0:29:09.45,0:29:12.87,Default,,0,0,0,,Anh cũng không muốn quay lại đâu.
Dialogue: 0,0:29:14.17,0:29:17.96,Default,,0,0,0,,Quay lại với bộ dạng này.
Dialogue: 0,0:29:19.84,0:29:20.96,Default,,0,0,0,,Chị về rồi!
Dialogue: 0,0:29:21.51,0:29:22.72,Default,,0,0,0,,Aoi?
Dialogue: 0,0:29:22.88,0:29:25.22,Default,,0,0,0,,Chị về sớm nhỉ?
Dialogue: 0,0:29:26.68,0:29:29.76,Default,,0,0,0,,Chị chỉ ở lại ăn thật nhiều thôi.
Dialogue: 0,0:29:29.85,0:29:33.60,Default,,0,0,0,,Hôm nay tắm xong rồi ngủ thôi.
Dialogue: 0,0:29:35.52,0:29:37.90,Default,,0,0,0,,Nè, hôm nay chúng ta ngủ chung nhé?
Dialogue: 0,0:29:38.77,0:29:41.23,Default,,0,0,0,,Có sao đâu? Cũng lâu rồi mà?
Dialogue: 0,0:29:48.03,0:29:48.91,Default,,0,0,0,,Nè.
Dialogue: 0,0:29:49.87,0:29:52.41,Default,,0,0,0,,Nói cho em nghe về Kanamuro Shinnosuke đi.
Dialogue: 0,0:29:53.54,0:29:54.96,Default,,0,0,0,,Chỉ là một tên say xỉn.
Dialogue: 0,0:29:55.04,0:29:57.75,Default,,0,0,0,,Không phải bây giờ, ngày xưa ấy.
Dialogue: 0,0:29:58.21,0:30:01.09,Default,,0,0,0,,Chị quên mấy chuyện ngày xưa rồi.
Dialogue: 0,0:30:01.59,0:30:03.92,Default,,0,0,0,,Toàn kí ức tồi tệ.
Dialogue: 0,0:30:06.63,0:30:10.26,Default,,0,0,0,,Nhưng sau từng đó năm chị vẫn không có bạn trai.
Dialogue: 0,0:30:11.35,0:30:14.27,Default,,0,0,0,,Có chứ.
Dialogue: 0,0:30:16.89,0:30:20.65,Default,,0,0,0,,Đùa à! Chị có bao giờ khoe em đâu? Sao dám giấu em hả?
Dialogue: 0,0:30:20.73,0:30:24.86,Default,,0,0,0,,Gì chứ? Hóa ra em cũng quan tâm đến chị nhỉ?
Dialogue: 0,0:30:25.65,0:30:26.86,Default,,0,0,0,,Cái quái gì thế?
Dialogue: 0,0:30:28.16,0:30:29.20,Default,,0,0,0,,Kệ chị!
Dialogue: 0,0:30:43.84,0:30:44.71,Default,,0,0,0,,Ngon quá!
Dialogue: 0,0:30:45.26,0:30:48.59,Default,,0,0,0,,Nhưng mà anh ăn bữa trưa của em ổn chứ?
Dialogue: 0,0:30:48.68,0:30:50.72,Default,,0,0,0,,Chút nữa em ra cửa hàng tiện lợi.
Dialogue: 0,0:30:50.85,0:30:51.72,Default,,0,0,0,,Thế à?
Dialogue: 0,0:30:52.18,0:30:53.06,Default,,0,0,0,,Vậy thì.
Dialogue: 0,0:30:57.19,0:31:00.06,Default,,0,0,0,,Em đang nghĩ anh cũng biết đói à?
Dialogue: 0,0:31:00.48,0:31:03.57,Default,,0,0,0,,Không hẳn... nhưng anh có thể ăn.
Dialogue: 0,0:31:03.82,0:31:06.07,Default,,0,0,0,,Căng nhất vẫn là nhàm chán.
Dialogue: 0,0:31:06.90,0:31:09.07,Default,,0,0,0,,Anh có guitar mà? Nếu chán thì.
Dialogue: 0,0:31:09.99,0:31:10.99,Default,,0,0,0,,Dây gỉ hết rồi.
Dialogue: 0,0:31:11.41,0:31:13.33,Default,,0,0,0,,Muốn em mua cây mới không? Nickel nhỉ?
Dialogue: 0,0:31:13.41,0:31:14.58,Default,,0,0,0,,Không.
Dialogue: 0,0:31:18.08,0:31:19.33,Default,,0,0,0,,Không cần đâu.
Dialogue: 0,0:31:19.42,0:31:21.50,Default,,0,0,0,,Thay vì thế thì mua hộ anh cuốn Jump.
Dialogue: 0,0:31:21.50,0:31:24.25,Default,,0,0,0,,Không đọc được Kochikame thì chán lắm.
Dialogue: 0,0:31:24.55,0:31:26.26,Default,,0,0,0,,Hết lâu rồi.
Dialogue: 0,0:31:27.22,0:31:28.76,Default,,0,0,0,,Làm gì có chuyện KochiKame hết chứ?
Dialogue: 0,0:31:29.09,0:31:31.34,Default,,0,0,0,,Nếu Ryo chết thì "vĩnh cửu" là gì?
Dialogue: 0,0:31:31.34,0:31:32.93,Default,,0,0,0,,Đừng có hỏi chứ.
Dialogue: 0,0:31:36.68,0:31:39.77,Default,,0,0,0,,Anh ta chẳng lo lắng gì cả.
Dialogue: 0,0:31:46.94,0:31:49.28,Default,,0,0,0,,Hả? Không phải Tsugu mà là Michinko?
Dialogue: 0,0:31:49.78,0:31:52.03,Default,,0,0,0,,Ngày xưa anh ấy trông thế này à?
Dialogue: 0,0:31:52.12,0:31:54.45,Default,,0,0,0,,Thảo nào Shinno gọi Tsugu là phiên bản thu nhỏ.
Dialogue: 0,0:31:56.95,0:31:58.29,Default,,0,0,0,,Akane.
Dialogue: 0,0:31:59.96,0:32:02.96,Default,,0,0,0,,Học cùng lớp.
Dialogue: 0,0:32:10.09,0:32:11.30,Default,,0,0,0,,Gớm chưa.
Dialogue: 0,0:32:10.97,0:32:13.30,Default,,0,0,0,,Thống trị thế giới
Dialogue: 0,0:32:11.43,0:32:13.30,Default,,0,0,0,,Học sinh tiểu học à?
Dialogue: 0,0:32:13.80,0:32:15.14,Default,,0,0,0,,Akane thì.
Dialogue: 0,0:32:17.64,0:32:20.31,Default,,0,0,0,,Cảm giác như sẽ viết giống mình.
Dialogue: 0,0:32:20.52,0:32:26.57,Default,,0,0,0,,Ếch dưới giếng không biết được sự bao la của đại dương nhưng nó biết được màu xanh của bầu trời.
Dialogue: 0,0:32:28.61,0:32:33.49,Default,,0,0,0,,"Nhưng nó biết được màu xanh của bầu trời" à?
Dialogue: 0,0:32:34.45,0:32:35.49,Default,,0,0,0,,Aioi!
Dialogue: 0,0:32:36.33,0:32:39.33,Default,,0,0,0,,Nè, cậu nghĩ lại được không?
Dialogue: 0,0:32:39.83,0:32:40.75,Default,,0,0,0,,Nếu tham gia ban nhạc của bọn tớ.
Dialogue: 0,0:32:40.83,0:32:44.17,Default,,0,0,0,,Tham gia ban nhạc kém cỏi\N chỉ phí thời gian của tôi.
Dialogue: 0,0:32:44.79,0:32:46.34,Default,,0,0,0,,Nói gì hả con lợn cái?
Dialogue: 0,0:32:46.67,0:32:49.17,Default,,0,0,0,,Đúng là xấu mồm mà.
Dialogue: 0,0:32:49.34,0:32:51.01,Default,,0,0,0,,Thật phí phạm.
Dialogue: 0,0:32:52.18,0:32:56.18,Default,,0,0,0,,Con gái duy nhất trong ban nhạc\N nam nghe tuyệt vậy mà.
Dialogue: 0,0:32:57.01,0:33:00.27,Default,,0,0,0,,Nhưng mà tớ đoán cậu sẽ chẳng quan tâm đến nó.
Dialogue: 0,0:33:00.35,0:33:04.85,Default,,0,0,0,,Dù sao cậu cũng sẽ đi Tokyo vì \Nông chú lớn tuổi kia mà nhỉ?
Dialogue: 0,0:33:06.86,0:33:11.28,Default,,0,0,0,,Có tin đồn cậu luôn được chàng trai nào đó đón bằng ô tô.
Dialogue: 0,0:33:11.36,0:33:14.36,Default,,0,0,0,,Nè, giới thiệu bạn của bạn trai cậu cho tớ đi!
Dialogue: 0,0:33:14.49,0:33:17.53,Default,,0,0,0,,Dù có thất bại tớ cũng không nói gì cậu đâu.
Dialogue: 0,0:33:20.37,0:33:22.71,Default,,0,0,0,,Vậy muốn đi luôn giờ không?
Dialogue: 0,0:33:26.21,0:33:28.63,Default,,0,0,0,,Tiếp theo, về ngân sách cho sân khấu-
Dialogue: 0,0:33:28.71,0:33:32.97,Default,,0,0,0,,Trước đó, cái tiền "Cho ngài \NNitobe học hỏi về tình yêu" này là gì?
Dialogue: 0,0:33:33.05,0:33:34.55,Default,,0,0,0,,À cái đó.
Dialogue: 0,0:33:38.14,0:33:38.85,Default,,0,0,0,,Đó là
Dialogue: 0,0:33:39.93,0:33:41.85,Default,,0,0,0,,kiểu như vậy.
Dialogue: 0,0:33:41.97,0:33:44.78,Default,,0,0,0,,Ồ, chỗ bán đá bào đó khá nổi tiếng nhỉ.
Dialogue: 0,0:33:45.94,0:33:48.74,Default,,0,0,0,,Hể? 18.000 yên cho đá bào?
Dialogue: 0,0:33:48.81,0:33:54.65,Default,,0,0,0,,Ông ấy bảo nếu không thử hết đặc sản thì \Nsẽ không tìm ra linh hồn của thị trấn.
Dialogue: 0,0:33:54.74,0:33:57.07,Default,,0,0,0,,Hi vọng lão ta nhanh bị đau bụng đi.
Dialogue: 0,0:33:57.57,0:33:58.49,Default,,0,0,0,,Nagatoro.
Dialogue: 0,0:33:58.57,0:34:00.41,Default,,0,0,0,,Chèo thuyền à...
Dialogue: 0,0:34:00.62,0:34:03.00,Default,,0,0,0,,Thịt lợn sốt miso và soba óc chó cho bữa trưa.
Dialogue: 0,0:34:03.08,0:34:04.58,Default,,0,0,0,,Lão này ăn bao nhiêu cho đủ đây?
Dialogue: 0,0:34:07.08,0:34:07.75,Default,,0,0,0,,Akane!
Dialogue: 0,0:34:12.21,0:34:13.21,Default,,0,0,0,,Chuyện gì?
Dialogue: 0,0:34:13.92,0:34:16.59,Default,,0,0,0,,Có vẻ em đang giận nhỉ?
Dialogue: 0,0:34:17.09,0:34:19.60,Default,,0,0,0,,Vậy em không nên giận hả?
Dialogue: 0,0:34:21.64,0:34:25.35,Default,,0,0,0,,Đêm qua anh nói rồi mà, chỉ là tình cờ
Dialogue: 0,0:34:25.43,0:34:28.94,Default,,0,0,0,,anh tìm thấy cậu ta và nhờ \Nmời ngài Nitobe đến thôi.
Dialogue: 0,0:34:29.36,0:34:32.94,Default,,0,0,0,,Nhưng nếu em cứ để mọi chuyện như vậy
Dialogue: 0,0:34:33.03,0:34:36.11,Default,,0,0,0,,thì sẽ chẳng thể nào giải quyết hết với Shinnosuke đâu.
Dialogue: 0,0:34:36.20,0:34:37.78,Default,,0,0,0,,Đủ rồi đấy.
Dialogue: 0,0:34:39.32,0:34:41.62,Default,,0,0,0,,Anh muốn can thiệp đến\N cuộc sống của em đến thế à?
Dialogue: 0,0:34:42.24,0:34:44.41,Default,,0,0,0,,Em cũng là con người đấy.
Dialogue: 0,0:34:44.50,0:34:48.33,Default,,0,0,0,,Cuộc sống của em là do em quyết định.
Dialogue: 0,0:34:50.04,0:34:53.59,Default,,0,0,0,,Em không muốn ai làm hộ điều đó.
Dialogue: 0,0:34:57.72,0:35:00.72,Default,,0,0,0,,Bạn trai cậu đang đi làm hả?
Dialogue: 0,0:35:01.18,0:35:02.76,Default,,0,0,0,,Anh ấy có bạn đại học không?
Dialogue: 0,0:35:03.85,0:35:08.73,Default,,0,0,0,,Mình chẳng thể hiểu nổi cậu ta\N nhưng trông khá lạc quan.
Dialogue: 0,0:35:10.19,0:35:12.06,Default,,0,0,0,,Làm mình nhớ đến Michinko.
Dialogue: 0,0:35:14.53,0:35:15.57,Default,,0,0,0,,Đến rồi hả?
Dialogue: 0,0:35:16.19,0:35:17.45,Default,,0,0,0,,Hả?
Dialogue: 0,0:35:17.53,0:35:20.24,Default,,0,0,0,,Bạn em hả? Xin chào!
Dialogue: 0,0:35:20.32,0:35:22.91,Default,,0,0,0,,Xin chào.
Dialogue: 0,0:35:24.16,0:35:26.41,Default,,0,0,0,,Có phải đàn ông đâu.
Dialogue: 0,0:35:27.71,0:35:28.37,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:35:28.71,0:35:30.04,Default,,0,0,0,,Bị hạ bởi hưu?
Dialogue: 0,0:35:32.00,0:35:33.42,Default,,0,0,0,,Hưu?
Dialogue: 0,0:35:33.84,0:35:38.59,Default,,0,0,0,,Phải. Anh Ito, bass và trống,\N anh Kodama bị ngộ độc thực phẩm.
Dialogue: 0,0:35:39.72,0:35:41.51,Default,,0,0,0,,Nó ngon lắm.
Dialogue: 0,0:35:41.59,0:35:42.76,Default,,0,0,0,,Tôi không còn gì hối tiếc.
Dialogue: 0,0:35:42.85,0:35:44.14,Default,,0,0,0,,Anh nên hối tiếc đi!
Dialogue: 0,0:35:44.22,0:35:46.10,Default,,0,0,0,,Tôi đã bảo phải ăn chín rồi mà!
Dialogue: 0,0:35:46.18,0:35:48.02,Default,,0,0,0,,Nếu chờ thì thằng này ăn mất!
Dialogue: 0,0:35:48.10,0:35:48.98,Default,,0,0,0,,Là mày đấy!
Dialogue: 0,0:35:49.06,0:35:52.94,Default,,0,0,0,,Ồ, kiểu như nghệ sĩ nhạc rock vậy!
Dialogue: 0,0:35:49.73,0:35:53.77,Default,,0,0,0,,Tóm lại phải mất cả tuần tịnh dưỡng đấy.
Dialogue: 0,0:35:49.73,0:35:53.77,Default,,0,0,0,,Đến khi nào hết viêm.
Dialogue: 0,0:35:54.56,0:35:56.94,Default,,0,0,0,,Vậy là không thể biểu diễn nhỉ?
Dialogue: 0,0:35:57.03,0:36:02.11,Default,,0,0,0,,Nhưng chúng tôi vẫn có máy\N phát âm thanh, tệ nhất thì phải hát chay.
Dialogue: 0,0:36:02.20,0:36:05.49,Default,,0,0,0,,Từ chối, tôi từ chối.
Dialogue: 0,0:36:05.58,0:36:07.12,Default,,0,0,0,,Ngài Nitobe?
Dialogue: 0,0:36:07.24,0:36:08.70,Default,,0,0,0,,Âm thanh là sinh vật sống.
Dialogue: 0,0:36:09.04,0:36:10.21,Default,,0,0,0,,Là hình dạng sự sống.
Dialogue: 0,0:36:10.33,0:36:13.96,Default,,0,0,0,,Nếu không phải là nhạc sống\N thì tôi sẽ không thể hát Enka.
Dialogue: 0,0:36:14.04,0:36:19.51,Default,,0,0,0,,Nitobe Daikichi này \Nkhông bao giờ xài nhạc ghi âm lại.
Dialogue: 0,0:36:19.59,0:36:20.80,Default,,0,0,0,,Nhưng.
Dialogue: 0,0:36:20.88,0:36:24.30,Default,,0,0,0,,Hay là tìm người thay thế.
Dialogue: 0,0:36:26.43,0:36:29.39,Default,,0,0,0,,Một tay trống và bass nhỉ?
Dialogue: 0,0:36:29.52,0:36:30.77,Default,,0,0,0,,Phải đó.
Dialogue: 0,0:36:30.85,0:36:32.06,Default,,0,0,0,,Có mà!
Dialogue: 0,0:36:32.19,0:36:33.19,Default,,0,0,0,,Tay trống
Dialogue: 0,0:36:33.27,0:36:34.56,Default,,0,0,0,,và bass.
Dialogue: 0,0:36:38.36,0:36:40.07,Default,,0,0,0,,Đùa nhau à?
Dialogue: 0,0:36:40.19,0:36:43.41,Default,,0,0,0,,Một nữ sinh cấp 3 và nhân viên Ủy ban nhỉ?
Dialogue: 0,0:36:43.53,0:36:44.70,Default,,0,0,0,,Nghe thú vị đó.
Dialogue: 0,0:36:44.78,0:36:45.87,Default,,0,0,0,,Không được đâu.
Dialogue: 0,0:36:45.95,0:36:48.95,Default,,0,0,0,,Nhưng ngài Nitobe thích ý tưởng đó lắm.
Dialogue: 0,0:36:49.04,0:36:51.79,Default,,0,0,0,,Lúc này ngài ấy đang ở Ủy ban giải thích tình hình.
Dialogue: 0,0:36:52.21,0:36:55.58,Default,,0,0,0,,Tại sao chuyện này lại xảy ra?
Dialogue: 0,0:36:55.71,0:36:58.05,Default,,0,0,0,,Tôi không muốn tham gia vào trò trẻ con này.
Dialogue: 0,0:36:58.55,0:37:00.76,Default,,0,0,0,,Tôi là dân chuyên nghiệp.
Dialogue: 0,0:37:02.05,0:37:04.43,Default,,0,0,0,,Dù anh từng nói em là ngôi sao tròng mắt.
Dialogue: 0,0:37:07.39,0:37:10.35,Default,,0,0,0,,Sao không thử xem coi đây có phải trò trẻ con không?
Dialogue: 0,0:37:10.43,0:37:12.39,Default,,0,0,0,,Này Aoi.
Dialogue: 0,0:37:12.48,0:37:15.10,Default,,0,0,0,,Good idea!
Dialogue: 0,0:37:16.06,0:37:18.61,Default,,0,0,0,,Hãy cho bọn tôi xem hai người có gì.
Dialogue: 0,0:37:38.79,0:37:39.96,Default,,0,0,0,,Michinko.
Dialogue: 0,0:37:51.10,0:37:53.64,Default,,0,0,0,,Nếu đi đến đó!
Dialogue: 0,0:37:53.77,0:38:01.32,Default,,0,0,0,,Thì tất cả giấc mơ sẽ thành hiện thực
Dialogue: 0,0:38:01.94,0:38:07.36,Default,,0,0,0,,Mọi người đều muốn tới
Dialogue: 0,0:38:07.45,0:38:09.24,Default,,0,0,0,,Ồ, hay đó.
Dialogue: 0,0:38:09.32,0:38:13.33,Default,,0,0,0,,Hay đó. Nhưng tại sao lại là Gandhara?
Dialogue: 0,0:38:15.79,0:38:18.67,Default,,0,0,0,,Ngầu quá!
Dialogue: 0,0:38:26.13,0:38:27.64,Default,,0,0,0,,Tuyệt vời!
Dialogue: 0,0:38:27.72,0:38:29.93,Default,,0,0,0,,Tôi yêu màn trình diễn này.
Dialogue: 0,0:38:30.01,0:38:34.02,Default,,0,0,0,,Đây sẽ là điểm nhấn của lễ hội lần này.
Dialogue: 0,0:38:50.49,0:38:51.99,Default,,0,0,0,,Tuyệt ghê!
Dialogue: 0,0:38:52.08,0:38:53.83,Default,,0,0,0,,Hay lắm Aoi.
Dialogue: 0,0:38:54.04,0:38:57.41,Default,,0,0,0,,Tuổi em mà đã được tham gia ban nhạc chuyên nghiệp.
Dialogue: 0,0:38:57.50,0:39:00.00,Default,,0,0,0,,Chỉ là em chăm chỉ thôi.
Dialogue: 0,0:39:00.08,0:39:01.50,Default,,0,0,0,,Vậy là tốt còn gì?
Dialogue: 0,0:39:01.59,0:39:07.05,Default,,0,0,0,,Nếu chị ở gần người thật thì chị Akane sẽ có nhiều cơ hội nói chuyện hơn.
Dialogue: 0,0:39:07.17,0:39:11.18,Default,,0,0,0,,Cơ hội để hai người trở nên gần gữi hơn nhỉ?
Dialogue: 0,0:39:11.26,0:39:12.22,Default,,0,0,0,,Nhưng mà.
Dialogue: 0,0:39:12.68,0:39:14.89,Default,,0,0,0,,liệu em có thể làm được chứ?
Dialogue: 0,0:39:15.68,0:39:17.73,Default,,0,0,0,,Trình diễn chuyên nghiệp.
Dialogue: 0,0:39:18.02,0:39:19.06,Default,,0,0,0,,Có thể chứ.
Dialogue: 0,0:39:19.52,0:39:23.23,Default,,0,0,0,,Em là ngôi sao tròng mắt giống anh mà.
Dialogue: 0,0:39:27.19,0:39:30.45,Default,,0,0,0,,Rồi, luyện tập thôi. Em mang nó đến mà nhỉ?
Dialogue: 0,0:39:30.53,0:39:32.24,Default,,0,0,0,,À vâng!
Dialogue: 0,0:39:32.70,0:39:33.58,Default,,0,0,0,,Này!
Dialogue: 0,0:39:34.37,0:39:36.70,Default,,0,0,0,,Aoi, em trong này hả?
Dialogue: 0,0:39:40.71,0:39:41.92,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:39:42.08,0:39:43.54,Default,,0,0,0,,Không có gì.
Dialogue: 0,0:39:43.63,0:39:45.25,Default,,0,0,0,,Còn chị thì sao, Akane?
Dialogue: 0,0:39:47.55,0:39:49.97,Default,,0,0,0,,À thì, xin lỗi.
Dialogue: 0,0:39:50.05,0:39:51.76,Default,,0,0,0,,Hôm nay đã ép em làm chuyện đó.
Dialogue: 0,0:39:53.26,0:39:57.43,Default,,0,0,0,,Khi nghĩ rằng em sẽ\N đứng trên sân khấu lớn thì chị.
Dialogue: 0,0:39:58.77,0:40:00.94,Default,,0,0,0,,Em, thấy không sao.
Dialogue: 0,0:40:01.10,0:40:05.27,Default,,0,0,0,,Em cũng, cảm thấy mong chờ nó.
Dialogue: 0,0:40:06.86,0:40:07.69,Default,,0,0,0,,Vậy à.
Dialogue: 0,0:40:07.78,0:40:10.45,Default,,0,0,0,,À, đây là bánh ngọt. Tsugu ăn nữa nhé.
Dialogue: 0,0:40:11.91,0:40:14.62,Default,,0,0,0,,Và đừng có thức khuya quá.
Dialogue: 0,0:40:17.79,0:40:19.79,Default,,0,0,0,,Chúng ta đã qua mặt chị ấy.
Dialogue: 0,0:40:19.96,0:40:20.79,Default,,0,0,0,,Ừm.
Dialogue: 0,0:40:23.29,0:40:24.79,Default,,0,0,0,,Hết hồn luôn!
Dialogue: 0,0:40:25.96,0:40:27.96,Default,,0,0,0,,Đã trở thành bà già rồi.
Dialogue: 0,0:40:28.09,0:40:29.47,Default,,0,0,0,,À thì.
Dialogue: 0,0:40:31.13,0:40:33.64,Default,,0,0,0,,Một bà già dễ thương.
Dialogue: 0,0:40:34.80,0:40:40.81,Default,,0,0,0,,Dễ thương và xinh đẹp hơn bất cứ người mẫu nào.
Dialogue: 0,0:40:43.31,0:40:45.15,Default,,0,0,0,,Anh, ổn chứ?
Dialogue: 0,0:40:46.32,0:40:47.65,Default,,0,0,0,,Ý em là sao?
Dialogue: 0,0:40:48.98,0:40:51.65,Default,,0,0,0,,Akane hẳn đã khó khăn suốt thời gian qua.
Dialogue: 0,0:40:52.82,0:40:57.49,Default,,0,0,0,,Với anh thì chỉ như hôm qua\N nhưng Akane đã luôn một mình.
Dialogue: 0,0:40:58.49,0:41:01.83,Default,,0,0,0,,Anh muốn làm Akane \Nhạnh phúc càng nhanh càng tốt.
Dialogue: 0,0:41:02.67,0:41:04.00,Default,,0,0,0,,Shinno.
Dialogue: 0,0:41:05.33,0:41:10.51,Default,,0,0,0,,Nhưng giờ chắc anh cũng là một\N ông chú với kĩ năng guitar điêu luyện nhỉ.
Dialogue: 0,0:41:10.84,0:41:12.68,Default,,0,0,0,,À vâng.
Dialogue: 0,0:41:12.80,0:41:13.84,Default,,0,0,0,,Thật à?
Dialogue: 0,0:41:14.01,0:41:16.01,Default,,0,0,0,,Muốn em ghi lại không?
Dialogue: 0,0:41:17.05,0:41:17.76,Default,,0,0,0,,Với cái này.
Dialogue: 0,0:41:18.18,0:41:19.35,Default,,0,0,0,,Được luôn à?
Dialogue: 0,0:41:20.02,0:41:21.48,Default,,0,0,0,,Điện thoại ngày nay ghê nhỉ.
Dialogue: 0,0:41:21.56,0:41:25.27,Default,,0,0,0,,Trò chơi lúc nãy cũng hay nữa. \NCho anh mượn chơi hết đêm nào.
Dialogue: 0,0:41:25.35,0:41:26.44,Default,,0,0,0,,Dẹp đi.
Dialogue: 0,0:41:26.52,0:41:27.52,Default,,0,0,0,,Vậy em cho mượn nhé?
Dialogue: 0,0:41:28.40,0:41:29.19,Default,,0,0,0,,Vậy được chứ?
Dialogue: 0,0:41:29.27,0:41:31.44,Default,,0,0,0,,Có sao đâu? Một đêm thôi mà.
Dialogue: 0,0:41:31.53,0:41:34.28,Default,,0,0,0,,Với cả có mỗi Akane với Tsugu gọi thôi.
Dialogue: 0,0:41:34.36,0:41:35.95,Default,,0,0,0,,Vậy mật khẩu là--
Dialogue: 0,0:41:36.03,0:41:37.41,Default,,0,0,0,,Này! Đó là thông tin cá nhân!
Dialogue: 0,0:41:37.49,0:41:38.87,Default,,0,0,0,,Cảm ơn Aoi!
Dialogue: 0,0:41:38.95,0:41:41.12,Default,,0,0,0,,Em được giáo dục tốt quá.
Dialogue: 0,0:41:41.20,0:41:43.54,Default,,0,0,0,,Này! Đừng có chạm vào đầu em!
Dialogue: 0,0:41:50.38,0:41:52.63,Default,,0,0,0,,Em thực sự sẽ ghi lại hả?
Dialogue: 0,0:41:52.72,0:41:53.72,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:41:54.88,0:41:58.39,Default,,0,0,0,,Nếu thấy bản thân lúc này, anh ấy có thể sẽ thất vọng.
Dialogue: 0,0:41:59.05,0:42:01.06,Default,,0,0,0,,Vậy à?\N Còn gì nữa.
Dialogue: 0,0:42:01.06,0:42:03.14,Default,,0,0,0,,Shinno có thể là thằng ngốc,
Dialogue: 0,0:42:03.14,0:42:07.06,Default,,0,0,0,,nhưng anh ấy rất tốt bụng và không bao giờ muốn liên lụy ai.
Dialogue: 0,0:42:11.03,0:42:11.73,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:42:12.74,0:42:14.24,Default,,0,0,0,,Không có gì.
Dialogue: 0,0:42:21.79,0:42:24.79,Default,,0,0,0,,Thế cậu làm gì ở đây?
Dialogue: 0,0:42:24.91,0:42:27.04,Default,,0,0,0,,Cậu sẽ quay phim anh Shinnosuke mà?
Dialogue: 0,0:42:27.12,0:42:29.21,Default,,0,0,0,,Cứ để chuyên gia này lo.
Dialogue: 0,0:42:29.29,0:42:32.50,Default,,0,0,0,,Tớ còn làm được mấy việc vặt như quản lý đó.
Dialogue: 0,0:42:32.76,0:42:35.67,Default,,0,0,0,,Khi em đến thì chị ấy đã ở đây.
Dialogue: 0,0:42:35.97,0:42:38.55,Default,,0,0,0,,Mà không sao, càng nhiều người quay càng tốt chứ sao.
Dialogue: 0,0:42:38.64,0:42:41.35,Default,,0,0,0,,Em hiểu ý chị đó, nhóc.
Dialogue: 0,0:42:41.43,0:42:42.64,Default,,0,0,0,,Đây rồi.
Dialogue: 0,0:42:42.97,0:42:47.02,Default,,0,0,0,,Vậy bắt đầu luyện tập. Chuẩn bị sẵn sàng.
Dialogue: 0,0:42:47.10,0:42:47.81,Default,,0,0,0,,Vâng.
Dialogue: 0,0:42:58.36,0:43:00.87,Default,,0,0,0,,Rồi, mọi người vất vả rồi.
Dialogue: 0,0:43:00.95,0:43:03.99,Default,,0,0,0,,Anh Shinnosuke ngầu quá đi.
Dialogue: 0,0:43:06.16,0:43:07.37,Default,,0,0,0,,Cái gì thế này?
Dialogue: 0,0:43:09.50,0:43:12.04,Default,,0,0,0,,Em đùa anh à, Aoi?
Dialogue: 0,0:43:14.13,0:43:15.55,Default,,0,0,0,,Em chơi bass mà?
Dialogue: 0,0:43:15.63,0:43:17.88,Default,,0,0,0,,Sao lại làm mình nổi bật?
Dialogue: 0,0:43:21.51,0:43:23.89,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:43:23.97,0:43:24.77,Default,,0,0,0,,Thiệt tình.
Dialogue: 0,0:43:24.85,0:43:28.89,Default,,0,0,0,,Con gái không hợp với bass đâu.
Dialogue: 0,0:43:29.48,0:43:33.23,Default,,0,0,0,,Vậy khi nào lớn em sẽ chơi bass \Ncho ban nhạc của bọn anh.
Dialogue: 0,0:43:33.82,0:43:36.73,Default,,0,0,0,,Tay và cơ thể em nhỏ nên\N không thể kiểm soát nhịp điệu.
Dialogue: 0,0:43:34.69,0:43:36.74,Default,,0,0,0,,Anh là người nói câu đó mà.
Dialogue: 0,0:43:36.82,0:43:41.45,Default,,0,0,0,,Thôi nào! Bọn này chỉ là người mới thôi, với cả mới chơi lần đầu nữa.
Dialogue: 0,0:43:41.53,0:43:45.74,Default,,0,0,0,,Người mới nhưng muốn đứng chung với\N dân chuyên chính là vấn đề ở đây.
Dialogue: 0,0:43:46.54,0:43:48.46,Default,,0,0,0,,Còn cậu, Michinko.
Dialogue: 0,0:43:48.54,0:43:51.92,Default,,0,0,0,,Sao lại đệm cho bass và phá hủy phần còn lại vậy?
Dialogue: 0,0:43:52.63,0:43:56.09,Default,,0,0,0,,Nếu tay trống không giữ được nhịp điệu thì\N anh ta không nên ở trong ban nhạc.
Dialogue: 0,0:43:56.21,0:43:57.01,Default,,0,0,0,,Shin-chan!
Dialogue: 0,0:43:57.09,0:43:58.42,Default,,0,0,0,,Anh đây rồi!
Dialogue: 0,0:43:59.31,0:44:01.14,Default,,0,0,0,,Chào, Eiko!
Dialogue: 0,0:44:01.60,0:44:03.93,Default,,0,0,0,,Bọn em đến rồi nè, Shin-chan.
Dialogue: 0,0:44:05.14,0:44:06.01,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:44:06.10,0:44:07.68,Default,,0,0,0,,Có vẻ họ đến đón anh.
Dialogue: 0,0:44:07.93,0:44:10.77,Default,,0,0,0,,Ngài Nitobe đã đi trước rồi.
Dialogue: 0,0:44:10.77,0:44:14.48,Default,,0,0,0,,Đúng là dân chuyên có khác.
Dialogue: 0,0:44:14.48,0:44:15.48,Default,,0,0,0,,À thì.
Dialogue: 0,0:44:15.48,0:44:17.48,Default,,0,0,0,,Đi thôi Shin.
Dialogue: 0,0:44:17.48,0:44:20.32,Default,,0,0,0,,Anh lúc say tuyệt lắm đó, Shinnosuke.
Dialogue: 0,0:44:20.32,0:44:23.28,Default,,0,0,0,,Anh ấy thuộc dạng hoang dã.
Dialogue: 0,0:44:23.28,0:44:25.20,Default,,0,0,0,,Hôm nay thế đủ rồi.
Dialogue: 0,0:44:25.33,0:44:26.20,Default,,0,0,0,,Ừm.
Dialogue: 0,0:44:27.66,0:44:29.04,Default,,0,0,0,,Chị làm gì thế?
Dialogue: 0,0:44:29.50,0:44:33.04,Default,,0,0,0,,Gửi đoạn quay phim đến máy của Aioi.
Dialogue: 0,0:44:37.00,0:44:41.18,Default,,0,0,0,,Thằng già chết tiệt!
Dialogue: 0,0:44:41.26,0:44:42.43,Default,,0,0,0,,Xem rồi à.
Dialogue: 0,0:44:42.51,0:44:45.35,Default,,0,0,0,,Lão già chơi guitar này bị gì thế?
Dialogue: 0,0:44:45.43,0:44:46.97,Default,,0,0,0,,Gái quán bar là sao?
Dialogue: 0,0:44:47.60,0:44:50.06,Default,,0,0,0,,Không thể giao Akane cho hắn được.
Dialogue: 0,0:44:50.06,0:44:54.06,Default,,0,0,0,,Phải dạy dỗ lại hắn trước khi trao trả cho Akane.
Dialogue: 0,0:44:55.98,0:44:57.57,Default,,0,0,0,,Nhưng mà.
Dialogue: 0,0:45:00.69,0:45:04.24,Default,,0,0,0,,Anh thực sự trở thành chuyên nghiệp nhỉ?
Dialogue: 0,0:45:05.37,0:45:07.74,Default,,0,0,0,,Tên khốn chết tiệt.
Dialogue: 0,0:45:08.37,0:45:11.29,Default,,0,0,0,,Tỏ ra mình thật ngầu nhưng thực ra có cái rốn lồi.
Dialogue: 0,0:45:11.37,0:45:12.29,Default,,0,0,0,,Rốn lồi?
Dialogue: 0,0:45:12.37,0:45:14.75,Default,,0,0,0,,Ờ, muốn xem không?
Dialogue: 0,0:45:14.83,0:45:16.13,Default,,0,0,0,,Không cần.
Dialogue: 0,0:45:16.13,0:45:19.76,Default,,0,0,0,,Giờ thì đến lượt Ao nhỉ.
Dialogue: 0,0:45:20.30,0:45:25.43,Default,,0,0,0,,Hãy trình diễn thật xuất sắc để đập tan cái sự tự cao của hắn nào!
Dialogue: 0,0:45:26.76,0:45:27.76,Default,,0,0,0,,Liệu.
Dialogue: 0,0:45:29.22,0:45:31.06,Default,,0,0,0,,sẽ thành công chứ?
Dialogue: 0,0:45:31.14,0:45:33.10,Default,,0,0,0,,Dĩ nhiên là được rồi!
Dialogue: 0,0:45:33.23,0:45:35.19,Default,,0,0,0,,Nếu là em thì chắc chắn.
Dialogue: 0,0:45:35.73,0:45:37.52,Default,,0,0,0,,Phải chứ, ngôi sao tròng mắt.
Dialogue: 0,0:45:40.65,0:45:41.61,Default,,0,0,0,,Vâng.
Dialogue: 0,0:45:42.07,0:45:42.82,Default,,0,0,0,,Vâng!
Dialogue: 0,0:45:42.90,0:45:45.07,Default,,0,0,0,,Rồi, luyện tập thôi!
Dialogue: 0,0:45:45.66,0:45:46.82,Default,,0,0,0,,Em có máy đếm nhịp không?
Dialogue: 0,0:45:46.91,0:45:49.83,Default,,0,0,0,,Em có ứng dụng trên điện thoại.
Dialogue: 0,0:45:49.91,0:45:52.66,Default,,0,0,0,,Lại điện thoại? Nó tuyệt quá vậy?
Dialogue: 0,0:45:53.54,0:45:55.29,Default,,0,0,0,,Ồ.
Dialogue: 0,0:45:55.58,0:46:00.46,Default,,0,0,0,,Nếu Shinno quay lại làm Shinnosuke đó,
Dialogue: 0,0:46:00.75,0:46:02.76,Default,,0,0,0,,thì Shinno này sẽ ra sao?
Dialogue: 0,0:46:02.84,0:46:06.72,Default,,0,0,0,,Với bass, dù mọi thứ có rối tung thế nào,
Dialogue: 0,0:46:06.80,0:46:11.47,Default,,0,0,0,,thì em chỉ cần theo nhịp điệu thật\N chính xác và hỗ trợ mọi người.
Dialogue: 0,0:46:11.85,0:46:15.81,Default,,0,0,0,,Trong khi lắng nghe mọi người xung quanh thì em cũng phải giữ nhịp độ bản thân nữa.
Dialogue: 0,0:46:18.94,0:46:19.82,Default,,0,0,0,,Vâng.
Dialogue: 0,0:46:23.32,0:46:24.82,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:46:24.90,0:46:27.24,Default,,0,0,0,,Shinnosuke không có à?
Dialogue: 0,0:46:27.24,0:46:30.16,Default,,0,0,0,,Tại sao? Sắp đến buổi diễn rồi đó.
Dialogue: 0,0:46:30.16,0:46:33.75,Default,,0,0,0,,Hôm nay cũng không có lịch luyện tập.
Dialogue: 0,0:46:33.75,0:46:39.00,Default,,0,0,0,,Với cả cậu ta nói rằng luyện tập với \Nđám nghiệp dư sẽ hạ thấp trình độ.
Dialogue: 0,0:46:41.17,0:46:42.42,Default,,0,0,0,,Tên khốn!
Dialogue: 0,0:46:43.34,0:46:45.84,Default,,0,0,0,,Đừng có xem thường người khác nữa!
Dialogue: 0,0:46:46.13,0:46:49.85,Default,,0,0,0,,Khác hoàn toàn với Shinno!\N Anh ta rốt cuộc là bị gì vậy?
Dialogue: 0,0:46:50.01,0:46:50.85,Default,,0,0,0,,Shinno?
Dialogue: 0,0:46:51.01,0:46:54.35,Default,,0,0,0,,À, biệt danh ngày xưa của Shinnosuke.
Dialogue: 0,0:46:54.98,0:46:58.69,Default,,0,0,0,,Sai! Shinno không phải là Shinnosuke!
Dialogue: 0,0:47:00.86,0:47:02.48,Default,,0,0,0,,Anh Nakamura!
Dialogue: 0,0:47:02.86,0:47:04.61,Default,,0,0,0,,Tôi đã mở rồi đó.
Dialogue: 0,0:47:04.61,0:47:07.70,Default,,0,0,0,,Cảm ơn! Nào Aoi, luyện tập thôi.
Dialogue: 0,0:47:08.03,0:47:11.87,Default,,0,0,0,,Nếu nhóm nhịp điệu chúng ta không tiến bộ thì sẽ chẳng có ý nghĩa gì hết.
Dialogue: 0,0:47:12.20,0:47:13.87,Default,,0,0,0,,Em biết!
Dialogue: 0,0:47:15.54,0:47:18.04,Default,,0,0,0,,Shinno và Shinnosuke nhỉ?
Dialogue: 0,0:47:18.37,0:47:22.38,Default,,0,0,0,,Ai cũng được, không có thì mình về.
Dialogue: 0,0:47:26.59,0:47:28.80,Default,,0,0,0,,Phần solo ghita tuyệt thật.
Dialogue: 0,0:47:28.88,0:47:30.05,Default,,0,0,0,,Phải chứ?
Dialogue: 0,0:47:30.22,0:47:30.97,Default,,0,0,0,,Làm được không?
Dialogue: 0,0:47:31.05,0:47:32.22,Default,,0,0,0,,Cái đó quá sức tao rồi.
Dialogue: 0,0:47:57.41,0:47:59.04,Default,,0,0,0,,Tìm thấy rồi!
Dialogue: 0,0:48:09.42,0:48:10.59,Default,,0,0,0,,Rồi.
Dialogue: 0,0:48:11.89,0:48:12.76,Default,,0,0,0,,Lần nữa.
Dialogue: 0,0:48:12.84,0:48:14.43,Default,,0,0,0,,Này, em ổn chứ?
Dialogue: 0,0:48:14.97,0:48:17.02,Default,,0,0,0,,Em đã chơi suốt từ nãy tới giờ rồi đó.
Dialogue: 0,0:48:17.02,0:48:20.52,Default,,0,0,0,,Và em cũng luyện tập với\N Michinko trước rồi mà nhỉ?
Dialogue: 0,0:48:20.52,0:48:21.69,Default,,0,0,0,,Em ổn.
Dialogue: 0,0:48:22.10,0:48:24.02,Default,,0,0,0,,Cũng gần 9 giờ rồi đó.
Dialogue: 0,0:48:24.15,0:48:27.03,Default,,0,0,0,,Những lúc này thì Michinko sẽ bỏ qua thôi.
Dialogue: 0,0:48:27.48,0:48:29.03,Default,,0,0,0,,Em không học hành gì à?
Dialogue: 0,0:48:29.11,0:48:30.49,Default,,0,0,0,,Không sao.
Dialogue: 0,0:48:30.82,0:48:33.24,Default,,0,0,0,,Em có định vào đại học đâu.
Dialogue: 0,0:48:33.32,0:48:35.03,Default,,0,0,0,,Vậy à? Thế em muốn làm gì?
Dialogue: 0,0:48:38.16,0:48:40.21,Default,,0,0,0,,Đến Tokyo và tham gia ban nhạc.
Dialogue: 0,0:48:41.50,0:48:44.54,Default,,0,0,0,,Một người sẽ đi theo con\N đường của anh đang ở đây!
Dialogue: 0,0:48:44.84,0:48:47.55,Default,,0,0,0,,Đừng có khen em thẳng thừng như thế.
Dialogue: 0,0:48:48.34,0:48:51.05,Default,,0,0,0,,Em không làm việc đó vì lý do gì cả.
Dialogue: 0,0:48:51.43,0:48:52.22,Default,,0,0,0,,Không á?
Dialogue: 0,0:48:53.51,0:48:56.22,Default,,0,0,0,,Em chỉ muốn rời khỏi đây...
Dialogue: 0,0:48:58.18,0:49:01.56,Default,,0,0,0,,và trả lại tự do cho chị Akane.
Dialogue: 0,0:49:02.52,0:49:05.90,Default,,0,0,0,,Vì em mà chị ấy đã kìm hãm bản thân
Dialogue: 0,0:49:06.69,0:49:09.90,Default,,0,0,0,,khỏi những chuyện muốn làm.
Dialogue: 0,0:49:11.53,0:49:17.08,Default,,0,0,0,,Nếu em ở đây, Akane sẽ bị trói buộc mãi.
Dialogue: 0,0:49:18.54,0:49:22.58,Default,,0,0,0,,Hơn nữa, em cũng chẳng có việc gì quan trọng phải làm,
Dialogue: 0,0:49:23.04,0:49:25.42,Default,,0,0,0,,nên không muốn chị ấy phí tiền cho em.
Dialogue: 0,0:49:26.17,0:49:29.92,Default,,0,0,0,,Em không muốn là gánh nặng cho chị ấy.
Dialogue: 0,0:49:30.84,0:49:33.09,Default,,0,0,0,,Em đang quá tiêu cực đó.
Dialogue: 0,0:49:33.26,0:49:37.26,Default,,0,0,0,,Không ai nghĩ đó là lỗi của em--\N Ai cũng nghĩ vậy cả.
Dialogue: 0,0:49:37.35,0:49:39.76,Default,,0,0,0,,Họ hàng hay hàng xóm đều thế.
Dialogue: 0,0:49:41.22,0:49:42.18,Default,,0,0,0,,Ao.
Dialogue: 0,0:49:43.39,0:49:44.69,Default,,0,0,0,,Đó là sự thật.
Dialogue: 0,0:49:45.48,0:49:48.19,Default,,0,0,0,,Thế nên em phải rời khỏi đây.
Dialogue: 0,0:49:49.15,0:49:51.03,Default,,0,0,0,,Em tuyệt thật đó.
Dialogue: 0,0:49:53.32,0:49:54.86,Default,,0,0,0,,Này.
Dialogue: 0,0:49:56.32,0:50:00.37,Default,,0,0,0,,Anh đã luôn suy nghĩ tại sao mình ở đây.
Dialogue: 0,0:50:00.99,0:50:02.87,Default,,0,0,0,,Linh hồn sống?
Dialogue: 0,0:50:04.50,0:50:07.88,Default,,0,0,0,,Anh không nghĩ là mình còn vương vấn gì cả.
Dialogue: 0,0:50:08.29,0:50:16.05,Default,,0,0,0,,Nhưng sự thật là đâu đó trong anh cảm thấy sợ hãi khi rời khỏi thị trấn này.
Dialogue: 0,0:50:17.01,0:50:19.89,Default,,0,0,0,,Và em thật tuyệt vời đó.
Dialogue: 0,0:50:20.35,0:50:21.89,Default,,0,0,0,,Dù có nhiều nỗi lo
Dialogue: 0,0:50:22.81,0:50:26.90,Default,,0,0,0,,nhưng em vẫn suy nghĩ và quyết định rõ ràng.
Dialogue: 0,0:50:32.69,0:50:34.69,Default,,0,0,0,,Trả lại cho lần trước.
Dialogue: 0,0:50:34.69,0:50:36.45,Default,,0,0,0,,Trả lại á?
Dialogue: 0,0:50:36.45,0:50:39.37,Default,,0,0,0,,Người chơi bass phải hỗ trợ mọi người mà.
Dialogue: 0,0:50:43.37,0:50:44.45,Default,,0,0,0,,Phải nhỉ!
Dialogue: 0,0:50:44.45,0:50:46.96,Default,,0,0,0,,Không hổ là tay bass tương lai ban nhạc của anh.
Dialogue: 0,0:50:46.96,0:50:49.63,Default,,0,0,0,,Ủa? Đây là tương lai mà nhỉ?
Dialogue: 0,0:50:49.63,0:50:50.34,Default,,0,0,0,,Vậy tức là.
Dialogue: 0,0:50:50.34,0:50:51.75,Default,,0,0,0,,Anh còn nhớ sao?
Dialogue: 0,0:50:52.88,0:50:56.59,Default,,0,0,0,,Nhớ? Anh đã hứa với em mà.
Dialogue: 0,0:50:56.93,0:50:59.55,Default,,0,0,0,,Chẳng phải đó là lý do em chơi bass sao?
Dialogue: 0,0:51:06.64,0:51:08.60,Default,,0,0,0,,Làm cho em nữa.
Dialogue: 0,0:51:08.85,0:51:11.27,Default,,0,0,0,,Làm gì? Xoa đầu á?
Dialogue: 0,0:51:11.65,0:51:14.28,Default,,0,0,0,,Trán. Búng vào trán. Làm ơn.
Dialogue: 0,0:51:15.90,0:51:17.40,Default,,0,0,0,,Cũng được.
Dialogue: 0,0:51:17.40,0:51:18.86,Default,,0,0,0,,Búng mạnh vào!
Dialogue: 0,0:51:18.86,0:51:20.28,Default,,0,0,0,,Rồi!
Dialogue: 0,0:51:21.20,0:51:23.79,Default,,0,0,0,,Đau!
Dialogue: 0,0:51:28.12,0:51:30.29,Default,,0,0,0,,Vậy gặp anh sau!
Dialogue: 0,0:51:31.29,0:51:32.29,Default,,0,0,0,,Này!
Dialogue: 0,0:51:32.46,0:51:33.63,Default,,0,0,0,,Ao?
Dialogue: 0,0:51:47.98,0:51:50.48,Default,,0,0,0,,Mình đang làm cái quái gì vậy?
Dialogue: 0,0:51:54.65,0:51:58.65,Default,,0,0,0,,Phải gắn kết Akane và Shinnosuke.
Dialogue: 0,0:51:59.24,0:52:00.82,Default,,0,0,0,,Vì lợi ích của Akane...
Dialogue: 0,0:52:02.16,0:52:03.83,Default,,0,0,0,,và Shinno nữa.
Dialogue: 0,0:52:07.83,0:52:09.83,Default,,0,0,0,,Chào buổi sáng!
Dialogue: 0,0:52:34.19,0:52:35.27,Default,,0,0,0,,Nghe nè!
Dialogue: 0,0:52:35.36,0:52:38.11,Default,,0,0,0,,Hôm qua Chika đi với đàn ông đó.
Dialogue: 0,0:52:38.19,0:52:39.28,Default,,0,0,0,,Cái gì? Thật hả?
Dialogue: 0,0:52:39.36,0:52:42.70,Default,,0,0,0,,Ờ, một ông chú và trông ngầu lắm.
Dialogue: 0,0:52:42.70,0:52:43.95,Default,,0,0,0,,Lão già á?
Dialogue: 0,0:52:43.95,0:52:45.95,Default,,0,0,0,,Nhưng nghe nói đẹp trai lắm.
Dialogue: 0,0:52:45.95,0:52:47.16,Default,,0,0,0,,Chắc giàu lắm.
Dialogue: 0,0:52:51.04,0:52:52.37,Default,,0,0,0,,Chào buổi sáng Aioi...
Dialogue: 0,0:52:52.67,0:52:55.04,Default,,0,0,0,,Hả? Ủa?
Dialogue: 0,0:52:56.59,0:52:59.55,Default,,0,0,0,,Đau! Thả tớ ra!
Dialogue: 0,0:53:01.05,0:53:03.97,Default,,0,0,0,,Người mà hôm qua cậu đi cùng.
Dialogue: 0,0:53:03.97,0:53:05.97,Default,,0,0,0,,Là Shinnosuke.
Dialogue: 0,0:53:07.85,0:53:08.81,Default,,0,0,0,,Tồi tệ.
Dialogue: 0,0:53:08.81,0:53:14.31,Default,,0,0,0,,Cái gì? Cậu thích Shinnosuke à?
Dialogue: 0,0:53:14.77,0:53:16.19,Default,,0,0,0,,Làm gì có!
Dialogue: 0,0:53:16.19,0:53:17.48,Default,,0,0,0,,Shinno là.
Dialogue: 0,0:53:22.95,0:53:23.86,Default,,0,0,0,,Thiệt tình.
Dialogue: 0,0:53:23.86,0:53:27.91,Default,,0,0,0,,Tớ không đụng vào người\N đàn ông của bạn mình đâu.
Dialogue: 0,0:53:27.91,0:53:31.00,Default,,0,0,0,,Shinno khác Shinnosuke mà nhỉ?
Dialogue: 0,0:53:31.45,0:53:32.37,Default,,0,0,0,,Phải.
Dialogue: 0,0:53:32.37,0:53:36.33,Default,,0,0,0,,Và cậu thích Shinno kia.
Dialogue: 0,0:53:39.59,0:53:41.51,Default,,0,0,0,,Phải, tớ thích!
Dialogue: 0,0:53:42.80,0:53:44.01,Default,,0,0,0,,C-cái tính cách gì thế?
Dialogue: 0,0:53:44.43,0:53:46.01,Default,,0,0,0,,Tớ thích anh ấy! Có được không?
Dialogue: 0,0:53:46.01,0:53:48.18,Default,,0,0,0,,Có ai nói là không được đâu...
Dialogue: 0,0:53:50.64,0:53:52.18,Default,,0,0,0,,Cậu làm gì thế? Này.
Dialogue: 0,0:53:52.18,0:53:53.69,Default,,0,0,0,,Nhưng không được.
Dialogue: 0,0:53:54.60,0:53:56.86,Default,,0,0,0,,Không thể được.
Dialogue: 0,0:53:57.65,0:53:59.19,Default,,0,0,0,,Aioi?
Dialogue: 0,0:54:18.17,0:54:19.38,Default,,0,0,0,,Ái chà.
Dialogue: 0,0:54:20.50,0:54:23.05,Default,,0,0,0,,Mình quên khóa cửa sáng nay à?
Dialogue: 0,0:54:26.01,0:54:28.89,Default,,0,0,0,,Aoi?
Dialogue: 0,0:54:30.64,0:54:32.22,Default,,0,0,0,,Em làm chị hết hồn đó.
Dialogue: 0,0:54:32.81,0:54:35.73,Default,,0,0,0,,Về trước thì phải gọi điện hay nhắn tin chứ.
Dialogue: 0,0:54:35.73,0:54:38.90,Default,,0,0,0,,Chị gọi mãi mà không được đó.
Dialogue: 0,0:54:40.02,0:54:41.23,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:54:43.32,0:54:44.57,Default,,0,0,0,,Shinno.
Dialogue: 0,0:54:45.86,0:54:48.41,Default,,0,0,0,,Sao chị không hẹn hò với Shinnosuke?
Dialogue: 0,0:54:51.08,0:54:52.29,Default,,0,0,0,,Sao tự nhiên lại hỏi vậy?
Dialogue: 0,0:54:52.29,0:54:53.95,Default,,0,0,0,,Nếu chị hẹn hò với anh ấy,
Dialogue: 0,0:54:54.54,0:54:58.67,Default,,0,0,0,,Thì anh ấy đã không trở thành tên khốn như thế!
Dialogue: 0,0:54:59.38,0:55:03.42,Default,,0,0,0,,Anh ấy sẽ quay lại Shinno ngày xưa!
Dialogue: 0,0:55:04.38,0:55:06.47,Default,,0,0,0,,Em đang nói gì vậy?
Dialogue: 0,0:55:06.47,0:55:10.30,Default,,0,0,0,,Em không muốn trở nên giống chị!
Dialogue: 0,0:55:11.97,0:55:15.31,Default,,0,0,0,,Kìm hãm bản thân, sau đó hối hận.
Dialogue: 0,0:55:15.31,0:55:16.52,Default,,0,0,0,,Không!
Dialogue: 0,0:55:17.31,0:55:19.98,Default,,0,0,0,,Và sau đó, để mọi chuyện kết thúc...
Dialogue: 0,0:55:20.40,0:55:22.61,Default,,0,0,0,,Em không chấp nhận nó!
Dialogue: 0,0:55:22.61,0:55:26.03,Default,,0,0,0,,Đây không phải điều mình muốn nói!
Dialogue: 0,0:55:26.82,0:55:28.20,Default,,0,0,0,,Akane, chị.
Dialogue: 0,0:55:29.66,0:55:30.74,Default,,0,0,0,,Chị.
Dialogue: 0,0:55:30.74,0:55:33.16,Default,,0,0,0,,Mình thực sự
Dialogue: 0,0:55:33.16,0:55:34.54,Default,,0,0,0,,là một con ngốc!
Dialogue: 0,0:55:39.42,0:55:41.54,Default,,0,0,0,,Một con ngốc à.
Dialogue: 0,0:55:47.01,0:55:48.22,Default,,0,0,0,,Này Aoi?
Dialogue: 0,0:56:40.31,0:56:41.77,Default,,0,0,0,,Cửa mở.
Dialogue: 0,0:56:43.81,0:56:46.94,Default,,0,0,0,,Aoi? Em trong đây à?
Dialogue: 0,0:57:05.96,0:57:09.80,Default,,0,0,0,,Em ấy không muốn trở nên giống mình à?
Dialogue: 0,0:57:39.45,0:57:41.33,Default,,0,0,0,,Lại là tảo biển.
Dialogue: 0,0:57:45.46,0:57:53.34,Default,,0,0,0,,Mình nghĩ... mình là một đứa... hết thuốc chữa rồi.
Dialogue: 0,0:57:53.34,0:57:57.64,Default,,0,0,0,,Phải đó, chị gửi tin nhắn gọi một thằng\N tiểu học đến lấy cây bass của mình,
Dialogue: 0,0:57:57.64,0:58:01.18,Default,,0,0,0,,sau đó xông  vào phòng nó và ở như đúng rồi
Dialogue: 0,0:58:01.18,0:58:03.02,Default,,0,0,0,,đúng là hết thuốc chữa.
Dialogue: 0,0:58:04.02,0:58:07.11,Default,,0,0,0,,Nhưng Shinnosuke còn tệ hơn chị cả ngàn lần!
Dialogue: 0,0:58:07.19,0:58:08.61,Default,,0,0,0,,Aoi, quần lót.
Dialogue: 0,0:58:08.61,0:58:09.86,Default,,0,0,0,,Quyết định rồi!
Dialogue: 0,0:58:13.86,0:58:16.28,Default,,0,0,0,,Ao, bình tĩnh.
Dialogue: 0,0:58:16.28,0:58:17.20,Default,,0,0,0,,Michinko!
Dialogue: 0,0:58:19.12,0:58:22.20,Default,,0,0,0,,Em sẽ giúp anh đến với chị Akane.
Dialogue: 0,0:58:27.54,0:58:29.54,Default,,0,0,0,,Ba, trễ rồi.
Dialogue: 0,0:58:30.92,0:58:36.88,Default,,0,0,0,,Aoi, em từng nói có chết cũng không\N cho chị lấy người đã ly hôn mà?
Dialogue: 0,0:58:36.88,0:58:38.34,Default,,0,0,0,,Em rút lại.
Dialogue: 0,0:58:38.89,0:58:42.06,Default,,0,0,0,,Thà cho chị ấy bên anh còn hơn bên Shinnosuke.
Dialogue: 0,0:58:44.81,0:58:48.90,Default,,0,0,0,,Anh cảm ơn nhưng không cần em giúp.
Dialogue: 0,0:58:50.48,0:58:55.90,Default,,0,0,0,,Công việc lần này là nhờ Shinno.
Dialogue: 0,0:59:01.08,0:59:04.95,Default,,0,0,0,,Em sẽ không thể tiến về phía trước\N nếu cứ dọn sẵn đường đâu.
Dialogue: 0,0:59:05.41,0:59:08.75,Default,,0,0,0,,Tuổi này rồi nó vậy. Cả anh và Akane.
Dialogue: 0,0:59:13.76,0:59:14.51,Default,,0,0,0,,Lạnh quá!
Dialogue: 0,0:59:14.71,0:59:16.38,Default,,0,0,0,,Này, em làm gì thế hả Aoi?
Dialogue: 0,0:59:16.38,0:59:17.55,Default,,0,0,0,,Dơ bẩn.
Dialogue: 0,0:59:18.05,0:59:20.80,Default,,0,0,0,,Người lớn và cái bụng phệ của anh nữa!
Dialogue: 0,0:59:20.89,0:59:22.10,Default,,0,0,0,,Tất cả đều dơ bẩn!
Dialogue: 0,0:59:23.56,0:59:24.56,Default,,0,0,0,,Ao.
Dialogue: 0,0:59:24.56,0:59:28.52,Default,,0,0,0,,Nè Tsugu, con mang khăn đến đây cho ba.
Dialogue: 0,0:59:29.06,0:59:30.27,Default,,0,0,0,,Tsugu!
Dialogue: 0,0:59:49.92,0:59:50.88,Default,,0,0,0,,Chị!
Dialogue: 0,0:59:53.09,0:59:54.84,Default,,0,0,0,,Em để cái này ở đâu?
Dialogue: 0,0:59:54.92,0:59:56.96,Default,,0,0,0,,À, để chị.
Dialogue: 0,0:59:57.76,1:00:00.26,Default,,0,0,0,,Xin lỗi nhé, thứ bảy mà lại phiền em.
Dialogue: 0,1:00:00.26,1:00:04.26,Default,,0,0,0,,Không sao, em không tham gia\N CLB nên cũng rảnh lắm.
Dialogue: 0,1:00:04.26,1:00:07.48,Default,,0,0,0,,Cho đến buổi diễn thì em sẽ giúp đỡ hết sức.
Dialogue: 0,1:00:08.35,1:00:10.81,Default,,0,0,0,,Aioi!
Dialogue: 0,1:00:10.81,1:00:12.48,Default,,0,0,0,,Này!
Dialogue: 0,1:00:16.19,1:00:17.82,Default,,0,0,0,,Lại bơ em.
Dialogue: 0,1:00:24.78,1:00:26.16,Default,,0,0,0,,Xin chào.
Dialogue: 0,1:00:27.54,1:00:30.71,Default,,0,0,0,,Đạo diễn ánh sáng đang tìm\N anh để xác định vị trí đó.
Dialogue: 0,1:00:30.79,1:00:32.17,Default,,0,0,0,,À, vâng.
Dialogue: 0,1:00:32.17,1:00:36.55,Default,,0,0,0,,Và ông ấy cũng đang tìm Shin..., anh Kanamuro.
Dialogue: 0,1:00:36.55,1:00:40.55,Default,,0,0,0,,Vậy à? Tôi sẽ nói ông ấy\N vị trí của Shinnosuke luôn.
Dialogue: 0,1:00:40.55,1:00:42.34,Default,,0,0,0,,Nhưng...
Dialogue: 0,1:00:42.55,1:00:44.68,Default,,0,0,0,,Đây là quê nhà của cậu ấy nhỉ?
Dialogue: 0,1:00:45.30,1:00:47.01,Default,,0,0,0,,Chắc có nhiều suy nghĩ lắm.
Dialogue: 0,1:00:47.72,1:00:48.68,Default,,0,0,0,,Suy nghĩ?
Dialogue: 0,1:00:49.23,1:00:54.02,Default,,0,0,0,,Tôi luôn làm việc ở hậu trường nhưng cậu ta từng được ra mắt solo cách đây không lâu.
Dialogue: 0,1:00:54.23,1:00:56.86,Default,,0,0,0,,Nhưng chỉ một bài duy nhất.
Dialogue: 0,1:01:00.99,1:01:02.36,Default,,0,0,0,,Vậy à.
Dialogue: 0,1:01:07.83,1:01:08.58,Default,,0,0,0,,Yama.
Dialogue: 0,1:01:08.66,1:01:09.87,Default,,0,0,0,,Motoyama.
Dialogue: 0,1:01:12.33,1:01:13.54,Default,,0,0,0,,Có chuyện gì?
Dialogue: 0,1:01:13.67,1:01:16.04,Default,,0,0,0,,Hôm nay em không đi chuẩn bị cho lễ hội à?
Dialogue: 0,1:01:16.50,1:01:18.00,Default,,0,0,0,,Có, chút nữa đi.
Dialogue: 0,1:01:18.75,1:01:20.55,Default,,0,0,0,,Em nghĩ nên nói cho anh trước.
Dialogue: 0,1:01:22.51,1:01:24.59,Default,,0,0,0,,Em thích Ao.
Dialogue: 0,1:01:25.34,1:01:26.89,Default,,0,0,0,,Tình đầu.
Dialogue: 0,1:01:32.02,1:01:33.94,Default,,0,0,0,,Sao anh lại xấu hổ?
Dialogue: 0,1:01:34.02,1:01:37.23,Default,,0,0,0,,C-Có xấu hổ gì đâu...
Dialogue: 0,1:01:38.86,1:01:42.40,Default,,0,0,0,,Em, già trước tuổi à?
Dialogue: 0,1:01:43.03,1:01:44.91,Default,,0,0,0,,Mà, thời này nó thế.
Dialogue: 0,1:01:45.36,1:01:48.62,Default,,0,0,0,,Nhưng khi em kiếm được việc,
Dialogue: 0,1:01:48.70,1:01:52.46,Default,,0,0,0,,khoảng cách 10 năm sẽ chẳng là vấn đề.
Dialogue: 0,1:01:53.21,1:01:56.25,Default,,0,0,0,,À ừm.
Dialogue: 0,1:01:56.46,1:02:01.84,Default,,0,0,0,,Thế nên nếu Ao không giỏi\N học thì em thay phần chị ấy.
Dialogue: 0,1:02:01.92,1:02:05.59,Default,,0,0,0,,Em sẽ trở thành một người đàn ông có giá.
Dialogue: 0,1:02:06.51,1:02:08.60,Default,,0,0,0,,Vậy à.
Dialogue: 0,1:02:09.43,1:02:11.43,Default,,0,0,0,,Em tuyệt nhỉ?
Dialogue: 0,1:02:12.85,1:02:15.60,Default,,0,0,0,,Nhưng em đã có đối thủ.
Dialogue: 0,1:02:16.23,1:02:17.15,Default,,0,0,0,,Thật á?
Dialogue: 0,1:02:17.15,1:02:18.11,Default,,0,0,0,,Phải.
Dialogue: 0,1:02:22.90,1:02:25.99,Default,,0,0,0,,Thế anh thấy Ao thế nào?
Dialogue: 0,1:02:25.99,1:02:27.91,Default,,0,0,0,,N-Này! Khoan đã!
Dialogue: 0,1:02:27.91,1:02:29.24,Default,,0,0,0,,Tsugu, bình tĩnh lại nào.
Dialogue: 0,1:02:29.24,1:02:31.95,Default,,0,0,0,,Câu đó phải nói anh.
Dialogue: 0,1:02:35.29,1:02:37.29,Default,,0,0,0,,Anh thì.
Dialogue: 0,1:02:37.79,1:02:42.13,Default,,0,0,0,,Cơ mà, anh vừa bị Akane từ chối.
Dialogue: 0,1:02:42.76,1:02:45.47,Default,,0,0,0,,Và lúc đó Aoi chỉ là một đứa nhóc.
Dialogue: 0,1:02:45.97,1:02:46.97,Default,,0,0,0,,Cơ mà!
Dialogue: 0,1:02:48.30,1:02:51.81,Default,,0,0,0,,Anh là linh hồn sống Shinnosuke, nên là...
Dialogue: 0,1:02:54.31,1:02:57.81,Default,,0,0,0,,Dù con bé có thích anh thì\N anh cũng chẳng thể làm gì.
Dialogue: 0,1:02:58.27,1:02:59.81,Default,,0,0,0,,Em đồng ý.
Dialogue: 0,1:03:01.15,1:03:02.15,Default,,0,0,0,,Thế nên.
Dialogue: 0,1:03:04.65,1:03:06.32,Default,,0,0,0,,Nè nè.
Dialogue: 0,1:03:06.78,1:03:09.16,Default,,0,0,0,,Còn định bơ tớ đến khi nào?
Dialogue: 0,1:03:10.32,1:03:12.12,Default,,0,0,0,,Tránh xa tớ ra, ma nữ.
Dialogue: 0,1:03:13.49,1:03:17.00,Default,,0,0,0,,Sao cực đoan thế.
Dialogue: 0,1:03:18.50,1:03:22.75,Default,,0,0,0,,Tớ đã nói chẳng có gì xảy ra rồi mà.
Dialogue: 0,1:03:22.75,1:03:24.67,Default,,0,0,0,,Làm gì có ai tin chứ!
Dialogue: 0,1:03:25.01,1:03:29.43,Default,,0,0,0,,Một tên vô lại và ả ma nữ đi\N cùng nhau sẽ là quan hệ bất chính--
Dialogue: 0,1:03:29.43,1:03:32.68,Default,,0,0,0,,Tớ cũng ngạc nhiên bản thân mình lắm.
Dialogue: 0,1:03:32.68,1:03:34.68,Default,,0,0,0,,Anh ấy rất nghiêm túc.
Dialogue: 0,1:03:34.97,1:03:36.18,Default,,0,0,0,,Đúng là phiền phức.
Dialogue: 0,1:03:38.39,1:03:42.90,Default,,0,0,0,,Ước gì có chàng hoàng tử nào \Nđó dẫn tớ thoát khỏi chuyện này.
Dialogue: 0,1:03:42.90,1:03:46.61,Default,,0,0,0,,Ootaki, tờ đăng kí đâu hết rồi?
Dialogue: 0,1:03:46.61,1:03:51.20,Default,,0,0,0,,Xin lỗi! Em để trên xe ở lối vào!
Dialogue: 0,1:04:22.73,1:04:27.49,Default,,0,0,0,,Nếu đến đó.
Dialogue: 0,1:04:28.49,1:04:33.91,Default,,0,0,0,,Nó nói rằng...
Dialogue: 0,1:04:34.99,1:04:39.58,Default,,0,0,0,,tất cả giấc mơ sẽ...
Dialogue: 0,1:04:48.59,1:04:50.26,Default,,0,0,0,,Sao anh lại dừng lại?
Dialogue: 0,1:04:53.59,1:04:54.68,Default,,0,0,0,,Chơi tiếp đi.
Dialogue: 0,1:05:04.31,1:05:10.69,Default,,0,0,0,,Anh cảm giác nếu lên Tokyo thì \Ngiấc mơ sẽ thành hiện thực.
Dialogue: 0,1:05:11.45,1:05:13.70,Default,,0,0,0,,Nhưng không.
Dialogue: 0,1:05:15.16,1:05:17.54,Default,,0,0,0,,Nhưng giấc mơ đã thành hiện thực mà.
Dialogue: 0,1:05:17.83,1:05:19.41,Default,,0,0,0,,Anh chơi ghita để kiếm sống.
Dialogue: 0,1:05:19.50,1:05:24.21,Default,,0,0,0,,Anh không muốn chơi ghita cho một ca sĩ Enka.
Dialogue: 0,1:05:24.21,1:05:25.04,Default,,0,0,0,,Nhưng.
Dialogue: 0,1:05:25.04,1:05:27.21,Default,,0,0,0,,Anh không có phàn nàn.
Dialogue: 0,1:05:28.00,1:05:30.05,Default,,0,0,0,,Anh cũng biết ơn ngài Nitobe.
Dialogue: 0,1:05:30.34,1:05:33.38,Default,,0,0,0,,Anh đã hài lòng với hiện tại, ít nhất là vậy.
Dialogue: 0,1:05:34.59,1:05:41.06,Default,,0,0,0,,Nhưng liệu nó có xứng đáng với những gì anh vứt bỏ?
Dialogue: 0,1:05:46.31,1:05:49.73,Default,,0,0,0,,Vậy em yêu cầu một bài hát khác được chứ?
Dialogue: 0,1:05:54.53,1:05:56.41,Default,,0,0,0,,"Bầu trời của cô ấy"
Dialogue: 0,1:05:59.70,1:06:00.54,Default,,0,0,0,,Tại sao em.
Dialogue: 0,1:06:01.20,1:06:02.41,Default,,0,0,0,,Em đã mua nó.
Dialogue: 0,1:06:02.41,1:06:04.42,Default,,0,0,0,,Bài hát ra mắt của anh.
Dialogue: 0,1:06:04.87,1:06:06.58,Default,,0,0,0,,Đó là lịch sử đen tối.
Dialogue: 0,1:06:08.88,1:06:12.09,Default,,0,0,0,,Em thích nó như bài Gandhara.
Dialogue: 0,1:06:30.90,1:06:34.03,Default,,0,0,0,,♪ Anh chẳng thể nào thích nó ♪
Dialogue: 0,1:06:34.40,1:06:39.91,Default,,0,0,0,,♪ Những bộ phim kinh dị và nụ hôn say mê ♪
Dialogue: 0,1:06:39.91,1:06:43.25,Default,,0,0,0,,♪ Anh chẳng thể nào thích nó ♪
Dialogue: 0,1:06:43.25,1:06:52.33,Default,,0,0,0,,♪ Dù vậy, những việc anh có thể làm lúc này ♪
Dialogue: 0,1:06:52.33,1:06:56.22,Default,,0,0,0,,♪ là tìm kiếm gương mặt của em ♪
Dialogue: 0,1:06:57.09,1:06:58.55,Default,,0,0,0,,Phong cách Nitobe Daikichi!
Dialogue: 0,1:06:59.43,1:07:05.06,Default,,0,0,0,,Có một lỗ hổng trong trái tim anh và một cánh cửa
Dialogue: 0,1:07:05.06,1:07:11.23,Default,,0,0,0,,Nó thật tối và anh không thể thấy
Dialogue: 0,1:07:11.61,1:07:16.99,Default,,0,0,0,,Cái gì vậy? Hát bình thường xem nào.
Dialogue: 0,1:07:17.36,1:07:21.49,Default,,0,0,0,,Chẳng có lý do do gì phía sau cả
Dialogue: 0,1:07:25.66,1:07:26.71,Default,,0,0,0,,Akane.
Dialogue: 0,1:07:27.87,1:07:29.08,Default,,0,0,0,,Và
Dialogue: 0,1:07:32.42,1:07:36.42,Default,,0,0,0,,người có thể làm Akane cười như vậy.
Dialogue: 0,1:07:38.05,1:07:39.13,Default,,0,0,0,,Quả nhiên...
Dialogue: 0,1:07:43.14,1:07:45.77,Default,,0,0,0,,chỉ có thể là Shinno.
Dialogue: 0,1:07:50.31,1:07:52.19,Default,,0,0,0,,Cảm ơn rất nhiều.
Dialogue: 0,1:07:54.78,1:07:56.61,Default,,0,0,0,,Đau bụng ghê.
Dialogue: 0,1:07:56.90,1:07:59.70,Default,,0,0,0,,Thiệt tình, anh nên hát bình thường đi.
Dialogue: 0,1:07:59.70,1:08:02.62,Default,,0,0,0,,Đúng là thật tuyệt khi có em bên cạnh.
Dialogue: 0,1:08:03.95,1:08:05.37,Default,,0,0,0,,Anh có thể thoải mái.
Dialogue: 0,1:08:06.79,1:08:09.12,Default,,0,0,0,,Anh đang nghĩ mình nên quay trở về.
Dialogue: 0,1:08:10.29,1:08:13.79,Default,,0,0,0,,Không hẳn là công việc này không có tương lai.
Dialogue: 0,1:08:13.79,1:08:14.88,Default,,0,0,0,,Không!
Dialogue: 0,1:08:15.30,1:08:22.26,Default,,0,0,0,,Biết nói sao nhỉ? Kiểu như ai\N cũng có công việc ổn định.
Dialogue: 0,1:08:22.26,1:08:25.18,Default,,0,0,0,,Và có lẽ anh cũng nên bắt đầu làm theo họ.
Dialogue: 0,1:08:25.18,1:08:29.31,Default,,0,0,0,,Không! Nếu thế Shinno sẽ biến mất!
Dialogue: 0,1:08:29.64,1:08:31.15,Default,,0,0,0,,Anh nói gì vậy?
Dialogue: 0,1:08:31.81,1:08:35.65,Default,,0,0,0,,Thời đại này thì 30 vẫn còn trẻ mà.
Dialogue: 0,1:08:36.15,1:08:38.65,Default,,0,0,0,,Còn quá sớm để ổn định.
Dialogue: 0,1:08:41.32,1:08:44.49,Default,,0,0,0,,Với em thì ở đây có việc em làm được.
Dialogue: 0,1:08:44.83,1:08:47.66,Default,,0,0,0,,Em vẫn chưa bỏ cuộc đâu.
Dialogue: 0,1:08:48.16,1:08:50.50,Default,,0,0,0,,Ừm. Từ bây giờ mới bắt đầu.
Dialogue: 0,1:08:57.13,1:08:58.17,Default,,0,0,0,,Vậy à.
Dialogue: 0,1:08:58.67,1:08:59.84,Default,,0,0,0,,Phải đó.
Dialogue: 0,1:09:00.51,1:09:02.68,Default,,0,0,0,,Ừm. Phải nhỉ.
Dialogue: 0,1:09:09.02,1:09:10.02,Default,,0,0,0,,Anh quay lại hả?
Dialogue: 0,1:09:10.35,1:09:12.69,Default,,0,0,0,,Ờ, phải đi thôi.
Dialogue: 0,1:09:13.31,1:09:14.36,Default,,0,0,0,,Gặp em sau.
Dialogue: 0,1:10:07.57,1:10:11.66,Default,,0,0,0,,Vậy ra Akane khóc như thế.
Dialogue: 0,1:10:13.08,1:10:14.58,Default,,0,0,0,,Mình đã không biết.
Dialogue: 0,1:10:15.54,1:10:17.42,Default,,0,0,0,,Lần cuối chị ấy khóc.
Dialogue: 0,1:10:19.63,1:10:21.92,Default,,0,0,0,,Đã bao lâu rồi?
Dialogue: 0,1:10:37.44,1:10:38.94,Default,,0,0,0,,Akane, chị có thể--
Dialogue: 0,1:10:58.13,1:10:59.38,Default,,0,0,0,,Thiệt là tình.
Dialogue: 0,1:11:05.84,1:11:07.84,Default,,0,0,0,,"Kế hoạch?"
Dialogue: 0,1:11:33.62,1:11:34.66,Default,,0,0,0,,Này Aoi!
Dialogue: 0,1:11:34.79,1:11:35.62,Default,,0,0,0,,Em ổn chứ?\N Ngon quá!
Dialogue: 0,1:11:35.79,1:11:41.17,Default,,0,0,0,,Thiệt tình Aoi, nếu không làm gì thì giúp chị đi.
Dialogue: 0,1:11:41.29,1:11:42.46,Default,,0,0,0,,Không!
Dialogue: 0,1:11:42.46,1:11:44.63,Default,,0,0,0,,Chị chiên đồ ăn giỏi lắm
Dialogue: 0,1:11:44.63,1:11:49.34,Default,,0,0,0,,vì thế các nguyên liệu vô cùng vui \Nsướng khi được đầu bếp tài hoa chế biến!
Dialogue: 0,1:11:51.39,1:11:52.51,Default,,0,0,0,,Chắc vậy.
Dialogue: 0,1:11:53.39,1:11:56.52,Default,,0,0,0,,Cái gì mà gánh nặng chứ?
Dialogue: 0,1:11:57.14,1:12:01.02,Default,,0,0,0,,Akane có thể làm mọi việc.
Dialogue: 0,1:12:01.56,1:12:07.03,Default,,0,0,0,,Nhưng chị ấy chỉ trở nên hoàn hảo.
Dialogue: 0,1:12:28.09,1:12:29.55,Default,,0,0,0,,vì mình.
Dialogue: 0,1:12:31.51,1:12:33.18,Default,,0,0,0,,Một thành công lớn khi làm Aoi vui!
Dialogue: 0,1:12:37.52,1:12:40.56,Default,,0,0,0,,Chị ấy đã cố hết sức,
Dialogue: 0,1:12:44.15,1:12:45.19,Default,,0,0,0,,vậy mà mình.
Dialogue: 0,1:12:49.24,1:12:53.24,Default,,0,0,0,,Mình đang làm gì vậy?
Dialogue: 0,1:13:29.94,1:13:32.11,Default,,0,0,0,,Ao à?
Dialogue: 0,1:13:32.24,1:13:35.03,Default,,0,0,0,,Không đọc mật khẩu làm anh hết hồn à.
Dialogue: 0,1:13:35.03,1:13:36.45,Default,,0,0,0,,Em thích anh Shinno.
Dialogue: 0,1:13:44.46,1:13:47.46,Default,,0,0,0,,Anh, vui lắm.
Dialogue: 0,1:13:47.46,1:13:49.63,Default,,0,0,0,,Nhưng mà hãy nghĩ kĩ đi.
Dialogue: 0,1:13:49.63,1:13:51.80,Default,,0,0,0,,Anh chỉ là--\N Im ngay!
Dialogue: 0,1:13:54.97,1:13:58.31,Default,,0,0,0,,Giọng của anh thật ấm áp.
Dialogue: 0,1:13:58.60,1:14:04.98,Default,,0,0,0,,Giọng nói đó sẽ nói những\N điều an ủi rất ấm áp và tình cảm.
Dialogue: 0,1:14:07.48,1:14:10.78,Default,,0,0,0,,Dù không có ý an ủi em,
Dialogue: 0,1:14:11.49,1:14:19.16,Default,,0,0,0,,nhưng giọng của anh tuyệt vời và ấm áp, nó khiến em buồn nên không muốn nghe!
Dialogue: 0,1:14:20.66,1:14:23.50,Default,,0,0,0,,Tóm lại hãy để em nói hết cảm xúc ra!
Dialogue: 0,1:14:34.84,1:14:36.84,Default,,0,0,0,,Em thích anh, Shinno.
Dialogue: 0,1:14:38.14,1:14:43.02,Default,,0,0,0,,Không phải Shinnosuke mà là Shinno đang ở đây lúc này.
Dialogue: 0,1:14:44.02,1:14:45.52,Default,,0,0,0,,Em muốn bên anh mãi mãi.
Dialogue: 0,1:14:46.52,1:14:49.36,Default,,0,0,0,,Anh đừng quay về làm Shinnosuke,
Dialogue: 0,1:14:49.48,1:14:51.19,Default,,0,0,0,,em muốn anh ở đây mãi!
Dialogue: 0,1:14:53.65,1:14:54.44,Default,,0,0,0,,Ao.
Dialogue: 0,1:14:54.44,1:14:55.70,Default,,0,0,0,,Nhưng.
Dialogue: 0,1:14:56.36,1:14:57.53,Default,,0,0,0,,Nhưng.
Dialogue: 0,1:14:58.70,1:15:02.04,Default,,0,0,0,,Em cũng yêu Akane nữa!
Dialogue: 0,1:15:04.20,1:15:05.37,Default,,0,0,0,,Và chị ấy.
Dialogue: 0,1:15:06.04,1:15:09.21,Default,,0,0,0,,vẫn yêu Shinnosuke.
Dialogue: 0,1:15:10.00,1:15:12.05,Default,,0,0,0,,Em đã nghĩ cho hạnh phúc của chị Akane.
Dialogue: 0,1:15:13.71,1:15:15.88,Default,,0,0,0,,Nhưng nếu vậy thì anh sẽ.
Dialogue: 0,1:15:18.22,1:15:20.72,Default,,0,0,0,,Em không biết phải làm sao nữa.
Dialogue: 0,1:15:21.72,1:15:24.06,Default,,0,0,0,,Nè, em phải làm sao?
Dialogue: 0,1:15:26.23,1:15:27.06,Default,,0,0,0,,Đừng có chạm vào!
Dialogue: 0,1:15:29.19,1:15:32.90,Default,,0,0,0,,Nếu chạm vào sẽ chỉ càng làm \Nem thêm thích anh thôi!
Dialogue: 0,1:15:33.65,1:15:36.32,Default,,0,0,0,,Vậy, anh phải làm gì?
Dialogue: 0,1:15:36.70,1:15:38.24,Default,,0,0,0,,Anh cũng không biết sao?
Dialogue: 0,1:15:38.53,1:15:39.82,Default,,0,0,0,,Sao anh biết chứ?
Dialogue: 0,1:15:39.82,1:15:41.07,Default,,0,0,0,,Vậy thì...
Dialogue: 0,1:15:44.41,1:15:45.29,Default,,0,0,0,,Bỏ đi!
Dialogue: 0,1:15:46.25,1:15:48.08,Default,,0,0,0,,Này khoan đã! Anh bảo khoan mà!
Dialogue: 0,1:15:48.62,1:15:49.92,Default,,0,0,0,,Nè!
Dialogue: 0,1:15:51.42,1:15:52.59,Default,,0,0,0,,Làm ơn.
Dialogue: 0,1:15:54.09,1:15:55.01,Default,,0,0,0,,Chờ đã.
Dialogue: 0,1:15:55.96,1:15:58.84,Default,,0,0,0,,Anh, không thể đuổi theo em.
Dialogue: 0,1:16:00.64,1:16:04.51,Default,,0,0,0,,Dù muốn nhưng cũng không được.
Dialogue: 0,1:16:06.64,1:16:08.85,Default,,0,0,0,,Tất cả những gì có thể làm là đứng đây nhìn em.
Dialogue: 0,1:16:10.94,1:16:17.86,Default,,0,0,0,,Anh cũng không biết sẽ\N thế nào nếu mình trở lại bản thể.
Dialogue: 0,1:16:18.78,1:16:27.20,Default,,0,0,0,,Nhưng khi thấy em bỏ đi với nước mắt như vậy...
Dialogue: 0,1:16:30.00,1:16:31.17,Default,,0,0,0,,Em không có khóc.
Dialogue: 0,1:16:32.67,1:16:34.04,Default,,0,0,0,,Em không khóc!
Dialogue: 0,1:16:34.50,1:16:36.05,Default,,0,0,0,,Là do mưa.
Dialogue: 0,1:16:44.18,1:16:47.89,Default,,0,0,0,,Nè, tại sao tao lại ở đây?
Dialogue: 0,1:16:52.19,1:16:54.23,Default,,0,0,0,,Tại sao?
Dialogue: 0,1:17:26.22,1:17:27.35,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,1:17:29.22,1:17:31.64,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,1:17:32.89,1:17:34.69,Default,,0,0,0,,Về chuyện hôm qua. Xin lỗi.
Dialogue: 0,1:17:35.65,1:17:37.90,Default,,0,0,0,,Không cần xin lỗi đâu.
Dialogue: 0,1:17:37.98,1:17:40.74,Default,,0,0,0,,Tớ cũng làm phiền cậu rất nhiều.
Dialogue: 0,1:17:40.74,1:17:41.90,Default,,0,0,0,,Được rồi-
Dialogue: 0,1:17:41.99,1:17:43.20,Default,,0,0,0,,Không có.
Dialogue: 0,1:17:43.53,1:17:45.03,Default,,0,0,0,,Không có!
Dialogue: 0,1:17:45.32,1:17:47.24,Default,,0,0,0,,Có chuyện gì vậy ạ?
Dialogue: 0,1:17:47.33,1:17:51.41,Default,,0,0,0,,Cái mặt dây chuyền tôi hay đeo, nó đâu mất rồi.
Dialogue: 0,1:17:51.50,1:17:55.38,Default,,0,0,0,,Mặt dây chuyền? À, cái gớm gớm đó.
Dialogue: 0,1:17:58.00,1:18:00.42,Default,,0,0,0,,Đó là nguồn gốc sức mạnh của tôi.
Dialogue: 0,1:18:00.42,1:18:05.30,Default,,0,0,0,,Tất cả cảm xúc của người dân địa phương \Nở đây đều được cất giữ trong đó.
Dialogue: 0,1:18:05.89,1:18:08.93,Default,,0,0,0,,Không có nó, tôi sẽ không thể hát bằng cả trái tim.
Dialogue: 0,1:18:08.93,1:18:12.23,Default,,0,0,0,,Không thể hát Enka bằng cả trái tim.
Dialogue: 0,1:18:12.98,1:18:15.90,Default,,0,0,0,,Câu này nghe quen lắm.
Dialogue: 0,1:18:17.36,1:18:20.73,Default,,0,0,0,,Ngài Nitobe, trong xe cũng không có.
Dialogue: 0,1:18:22.11,1:18:23.15,Default,,0,0,0,,Ngài Nitobe...
Dialogue: 0,1:18:23.24,1:18:27.32,Default,,0,0,0,,Lần cuối ngài thấy nó ở đâu?
Dialogue: 0,1:18:27.78,1:18:28.99,Default,,0,0,0,,Lần cuối?
Dialogue: 0,1:18:29.08,1:18:32.08,Default,,0,0,0,,Nếu là thế thì...
Dialogue: 0,1:18:32.20,1:18:33.79,Default,,0,0,0,,A, di tích Wado.
Dialogue: 0,1:18:33.87,1:18:35.08,Default,,0,0,0,,Đây rồi!
Dialogue: 0,1:18:35.17,1:18:38.29,Default,,0,0,0,,Đây là đền Mitsumine?
Dialogue: 0,1:18:38.29,1:18:40.05,Default,,0,0,0,,Vui hơi quá rồi đó.
Dialogue: 0,1:18:40.05,1:18:44.42,Default,,0,0,0,,Cơ mà bức nào cũng thấy ôm gái...
Dialogue: 0,1:18:45.30,1:18:48.14,Default,,0,0,0,,Đó gọi là quan hệ tốt với dân địa phương.
Dialogue: 0,1:18:48.14,1:18:50.68,Default,,0,0,0,,Đống này là chụp từ hôm qua.
Dialogue: 0,1:18:50.68,1:18:51.81,Default,,0,0,0,,A, tấm này.
Dialogue: 0,1:18:51.81,1:18:53.68,Default,,0,0,0,,Tấm này không còn nữa nè.
Dialogue: 0,1:18:53.68,1:18:54.89,Default,,0,0,0,,Đúng thật.
Dialogue: 0,1:18:54.89,1:18:56.48,Default,,0,0,0,,Tức là...
Dialogue: 0,1:18:56.48,1:18:58.90,Default,,0,0,0,,Nơi mà thấy nó lần cuối...
Dialogue: 0,1:18:59.31,1:19:00.15,Default,,0,0,0,,Ở đây!
Dialogue: 0,1:19:00.15,1:19:01.65,Default,,0,0,0,,A, đường hầm này!
Dialogue: 0,1:19:01.65,1:19:03.44,Default,,0,0,0,,Khá là mê mẩn nhỉ.
Dialogue: 0,1:19:03.44,1:19:06.82,Default,,0,0,0,,Có một hàng rào nhưng tôi đã băng qua nó.
Dialogue: 0,1:19:06.82,1:19:07.82,Default,,0,0,0,,Chính nó!
Dialogue: 0,1:19:07.82,1:19:12.58,Default,,0,0,0,,Phải nhỉ, nó mang lại cảm giác như đang sinh tồn.
Dialogue: 0,1:19:12.58,1:19:14.54,Default,,0,0,0,,Vậy tôi sẽ đi tìm nó.
Dialogue: 0,1:19:14.54,1:19:16.79,Default,,0,0,0,,Hả? Được chứ?
Dialogue: 0,1:19:17.25,1:19:19.29,Default,,0,0,0,,Ngài cứ ở đây chuẩn bị trình diễn đi.
Dialogue: 0,1:19:19.83,1:19:22.13,Default,,0,0,0,,Akane, cẩn thận đó.
Dialogue: 0,1:19:36.48,1:19:37.64,Default,,0,0,0,,Akane!
Dialogue: 0,1:19:38.65,1:19:39.48,Default,,0,0,0,,Aoi?
Dialogue: 0,1:19:41.31,1:19:42.32,Default,,0,0,0,,Có chuyện gì sao?
Dialogue: 0,1:19:44.65,1:19:45.40,Default,,0,0,0,,Không...
Dialogue: 0,1:19:47.15,1:19:48.82,Default,,0,0,0,,Cẩn thận đó.
Dialogue: 0,1:19:49.61,1:19:52.83,Default,,0,0,0,,Ừm, em cũng cố hết sức đó.
Dialogue: 0,1:19:55.00,1:19:57.96,Default,,0,0,0,,Trong khi tin tưởng mặt dây chuyền trở về,
Dialogue: 0,1:19:58.50,1:20:01.50,Default,,0,0,0,,hãy cố hết sức nào.
Dialogue: 0,1:20:01.84,1:20:04.50,Default,,0,0,0,,Đừng để cảm xúc của dân địa phương lãng phí.
Dialogue: 0,1:20:04.96,1:20:07.17,Default,,0,0,0,,Không có thời gian nghỉ ngơi đâu.
Dialogue: 0,1:20:07.17,1:20:09.68,Default,,0,0,0,,Không thể tin là ông ta lại nói được câu đó.
Dialogue: 0,1:20:09.68,1:20:11.59,Default,,0,0,0,,Và anh Shinnosuke đâu?
Dialogue: 0,1:20:11.59,1:20:16.85,Default,,0,0,0,,À, nghe nói có việc cần làm nên chút nữa đến sau.
Dialogue: 0,1:20:56.31,1:20:57.89,Default,,0,0,0,,Xem nào.
Dialogue: 0,1:20:58.56,1:21:02.40,Default,,0,0,0,,Thiệt tình. Nơi này kéo dài đến đâu đây?
Dialogue: 0,1:21:17.08,1:21:18.24,Default,,0,0,0,,Động đất?
Dialogue: 0,1:21:29.17,1:21:31.42,Default,,0,0,0,,Chắc chắn là có rung chấn.\N Vâng, Nakamura đây.
Dialogue: 0,1:21:31.42,1:21:32.43,Default,,0,0,0,,Thế à?
Dialogue: 0,1:21:32.97,1:21:35.43,Default,,0,0,0,,Vâng... Vâng...\N Vẫn chưa lên tin tức...
Dialogue: 0,1:21:37.18,1:21:39.68,Default,,0,0,0,,Vâng, đã rõ.
Dialogue: 0,1:21:39.68,1:21:41.27,Default,,0,0,0,,Chuyện gì vậy?
Dialogue: 0,1:21:41.27,1:21:43.60,Default,,0,0,0,,Có vụ lở đất gần Hino.
Dialogue: 0,1:21:43.60,1:21:47.90,Default,,0,0,0,,Anh phải đi thông báo ở cục Du lịch.
Dialogue: 0,1:21:47.90,1:21:48.86,Default,,0,0,0,,Lở đất?
Dialogue: 0,1:21:48.86,1:21:49.86,Default,,0,0,0,,Cái gì?
Dialogue: 0,1:21:49.86,1:21:52.86,Default,,0,0,0,,Chuyện này xảy ra ở trong núi
Dialogue: 0,1:21:52.86,1:21:56.03,Default,,0,0,0,,nên chúng tôi vẫn chưa xác nhận thiệt hại nào.
Dialogue: 0,1:21:56.03,1:21:58.54,Default,,0,0,0,,Vậy à?\N Quả nhiên là trận động đất khi nãy.
Dialogue: 0,1:21:58.54,1:22:01.12,Default,,0,0,0,,Hôm qua mưa khá to mà.
Dialogue: 0,1:22:01.12,1:22:03.96,Default,,0,0,0,,Hino? Đường hầm Akane đến là ở Hino mà!
Dialogue: 0,1:22:05.96,1:22:07.79,Default,,0,0,0,,A-Akane ổn chứ?\N Ao!
Dialogue: 0,1:22:08.67,1:22:10.63,Default,,0,0,0,,Bình tĩnh, lấy điện thoại ra.
Dialogue: 0,1:22:13.84,1:22:15.05,Default,,0,0,0,,Aioi.
Dialogue: 0,1:22:19.51,1:22:21.72,Default,,0,0,0,,Không được. Không kết nối được.
Dialogue: 0,1:22:21.72,1:22:24.06,Default,,0,0,0,,Cháu nghĩ quá lên thôi.
Dialogue: 0,1:22:24.35,1:22:26.60,Default,,0,0,0,,Không nên bi quan.
Dialogue: 0,1:22:26.60,1:22:28.90,Default,,0,0,0,,Hãy tích cực và tin tưởng!
Dialogue: 0,1:22:29.15,1:22:30.40,Default,,0,0,0,,Ai chứ ông thì im hộ.
Dialogue: 0,1:22:30.40,1:22:32.90,Default,,0,0,0,,Tóm lại anh sẽ đến Ủy ban.
Dialogue: 0,1:22:32.90,1:22:36.24,Default,,0,0,0,,Anh sẽ tìm thông tin nên cứ chờ ở đây.
Dialogue: 0,1:22:36.87,1:22:39.62,Default,,0,0,0,,Xin lỗi ngài Nitobe. Nhưng ngài hãy chờ ở đây.
Dialogue: 0,1:22:39.62,1:22:41.95,Default,,0,0,0,,Ờ, hãy cẩn thận.
Dialogue: 0,1:22:42.95,1:22:43.79,Default,,0,0,0,,Tsugu, nhờ con lo cho mọi người!
Dialogue: 0,1:22:43.87,1:22:44.91,Default,,0,0,0,,Vâng.
Dialogue: 0,1:22:47.25,1:22:48.42,Default,,0,0,0,,Ao.
Dialogue: 0,1:22:53.88,1:22:56.09,Default,,0,0,0,,Này, Aioi?
Dialogue: 0,1:22:59.01,1:23:02.27,Default,,0,0,0,,Phải nên hãy đưa xe đến... Hả?
Dialogue: 0,1:23:02.64,1:23:04.60,Default,,0,0,0,,N-Này Ao!
Dialogue: 0,1:23:05.39,1:23:06.94,Default,,0,0,0,,Em đi đâu vậy?
Dialogue: 0,1:23:08.56,1:23:13.28,Default,,0,0,0,,Tại sao bản thể cấp 3 của mình lại ở đây?
Dialogue: 0,1:23:15.45,1:23:16.49,Default,,0,0,0,,Hiểu rồi.
Dialogue: 0,1:23:17.20,1:23:18.11,Default,,0,0,0,,Quả nhiên...
Dialogue: 0,1:23:20.07,1:23:22.62,Default,,0,0,0,,Đến lấy Akane Special à?
Dialogue: 0,1:23:24.16,1:23:25.29,Default,,0,0,0,,Sao cậu...
Dialogue: 0,1:23:26.12,1:23:27.71,Default,,0,0,0,,Cái ghita quý giá
Dialogue: 0,1:23:27.79,1:23:31.17,Default,,0,0,0,,mà cậu và Akane đã cùng nhau mua sau khi tiết kiệm đủ tiền.
Dialogue: 0,1:23:31.88,1:23:34.67,Default,,0,0,0,,Có vẻ nó bị bỏ rơi ở đây khá lâu.
Dialogue: 0,1:23:37.55,1:23:43.35,Default,,0,0,0,,Kém cỏi. Chỉ vì giấc mơ không thành hiện thực mà hờn dỗi như đứa trẻ.
Dialogue: 0,1:23:44.39,1:23:45.89,Default,,0,0,0,,Con nít thì biết cái gì?
Dialogue: 0,1:23:45.89,1:23:50.02,Default,,0,0,0,,Tôi không muốn biết về một lão già chết tiệt nào đó.
Dialogue: 0,1:23:50.31,1:23:51.65,Default,,0,0,0,,Cậu
Dialogue: 0,1:23:55.32,1:23:56.36,Default,,0,0,0,,Shin
Dialogue: 0,1:23:59.16,1:24:01.53,Default,,0,0,0,,Shin... nosuke?
Dialogue: 0,1:24:02.24,1:24:03.24,Default,,0,0,0,,Tại sao?
Dialogue: 0,1:24:03.33,1:24:05.04,Default,,0,0,0,,Có chuyện gì à, Ao?
Dialogue: 0,1:24:05.70,1:24:07.71,Default,,0,0,0,,Đúng rồi Shinno! Chị Akane.
Dialogue: 0,1:24:11.00,1:24:11.92,Default,,0,0,0,,Lở đất?
Dialogue: 0,1:24:11.92,1:24:13.09,Default,,0,0,0,,Và Akane--
Dialogue: 0,1:24:13.09,1:24:15.09,Default,,0,0,0,,Em vẫn chưa biết.
Dialogue: 0,1:24:15.09,1:24:18.05,Default,,0,0,0,,Bây giờ Michinko đang tìm kiếm.
Dialogue: 0,1:24:18.42,1:24:20.89,Default,,0,0,0,,Em nghĩ chị ấy ổn nhưng...
Dialogue: 0,1:24:20.89,1:24:27.56,Default,,0,0,0,,Nhưng không gọi được và\N em có cảm giác không ổn.
Dialogue: 0,1:24:28.43,1:24:30.73,Default,,0,0,0,,Đừng hù anh chứ.
Dialogue: 0,1:24:31.02,1:24:34.73,Default,,0,0,0,,Vậy thì chờ Michinko liên lạc lại.
Dialogue: 0,1:24:35.48,1:24:37.40,Default,,0,0,0,,Sao cậu lại bình tĩnh đến thế?
Dialogue: 0,1:24:38.86,1:24:41.57,Default,,0,0,0,,Sao cứ đứng yên ở đó hả?
Dialogue: 0,1:24:42.20,1:24:43.12,Default,,0,0,0,,Sao á?
Dialogue: 0,1:24:43.12,1:24:45.74,Default,,0,0,0,,Mau đi tìm Akane đi!
Dialogue: 0,1:24:45.74,1:24:47.95,Default,,0,0,0,,Sao chẳng làm gì thế hả?
Dialogue: 0,1:24:47.95,1:24:50.00,Default,,0,0,0,,Đã nói là dù có đi thì.
Dialogue: 0,1:24:50.00,1:24:50.90,Default,,0,0,0,,Nếu không-
Dialogue: 0,1:24:51.79,1:24:52.88,Default,,0,0,0,,Này.
Dialogue: 0,1:24:52.88,1:24:55.21,Default,,0,0,0,,Nếu cậu không đi thì ai đi?
Dialogue: 0,1:24:56.88,1:24:58.97,Default,,0,0,0,,Đừng làm tôi thất vọng.
Dialogue: 0,1:25:00.22,1:25:01.43,Default,,0,0,0,,Shinno.
Dialogue: 0,1:25:02.09,1:25:07.27,Default,,0,0,0,,Không phải cậu trở nên nổi tiếng và trở về đón Akane sao?
Dialogue: 0,1:25:08.64,1:25:11.27,Default,,0,0,0,,Thay vào đó lại là thành viên ban nhạc cánh gà.
Dialogue: 0,1:25:11.39,1:25:12.90,Default,,0,0,0,,Và chơi cho ca sĩ Enka?
Dialogue: 0,1:25:12.90,1:25:14.31,Default,,0,0,0,,Thật không thể tin nổi!
Dialogue: 0,1:25:14.35,1:25:14.90,Default,,0,0,0,,Im đi!
Dialogue: 0,1:25:14.91,1:25:17.23,Default,,0,0,0,,Nhục nhã! Nhục nhã! Nhục nhã!
Dialogue: 0,1:25:17.23,1:25:19.28,Default,,0,0,0,,Tôi thấy mình như chìm trong một vũng lầy!
Dialogue: 0,1:25:19.53,1:25:22.03,Default,,0,0,0,,- Tương lai lại trở thành một thằng như cậu.\N - Im mồm!
Dialogue: 0,1:25:22.24,1:25:24.07,Default,,0,0,0,,- Dừng lại!\N - Tôi.
Dialogue: 0,1:25:24.66,1:25:26.99,Default,,0,0,0,,ngày nào cũng làm một cái gì đó!
Dialogue: 0,1:25:26.99,1:25:29.50,Default,,0,0,0,,Ờ, cậu chơi ghita giỏi hơn rồi đấy.
Dialogue: 0,1:25:29.75,1:25:32.54,Default,,0,0,0,,Với khả năng đó thì cậu có thể chơi ở bất cứ đâu!
Dialogue: 0,1:25:32.54,1:25:35.92,Default,,0,0,0,,Thế giới này phải có quan hệ và may mắn!
Dialogue: 0,1:25:35.92,1:25:38.21,Default,,0,0,0,,Chỉ vì cậu giỏi không có nghĩa là cậu sẽ thành công.
Dialogue: 0,1:25:38.21,1:25:39.55,Default,,0,0,0,,Một thằng nhãi như cậu thì biết cái gì!
Dialogue: 0,1:25:39.55,1:25:41.97,Default,,0,0,0,,Ờ, tôi chẳng biết cái quái gì cả!
Dialogue: 0,1:25:43.30,1:25:47.18,Default,,0,0,0,,Vì tôi không thể rời khỏi đây...
Dialogue: 0,1:25:48.14,1:25:48.97,Default,,0,0,0,,Hả?
Dialogue: 0,1:25:49.52,1:25:50.68,Default,,0,0,0,,Shinno...
Dialogue: 0,1:25:51.35,1:25:55.31,Default,,0,0,0,,Ngày đó, khi Akane nói không đi Tokyo cùng tôi.
Dialogue: 0,1:25:55.86,1:25:57.52,Default,,0,0,0,,Tôi đã rất sốc.
Dialogue: 0,1:25:58.36,1:26:01.78,Default,,0,0,0,,Đi Tokyo, lập ban nhạc, biểu diễn liên tục,
Dialogue: 0,1:26:02.49,1:26:06.03,Default,,0,0,0,,ra mắt và vui vẻ mỗi ngày.
Dialogue: 0,1:26:06.66,1:26:08.70,Default,,0,0,0,,Tất cả là giấc mơ của tôi nhưng
Dialogue: 0,1:26:09.66,1:26:16.88,Default,,0,0,0,,đó là chỉ khi có Akane bên cạnh.
Dialogue: 0,1:26:18.54,1:26:22.01,Default,,0,0,0,,Tôi đã nói sẽ trở nên nổi tiếng và quay về đón cô ấy,
Dialogue: 0,1:26:22.01,1:26:24.22,Default,,0,0,0,,nhưng chẳng ai biết được tương lai.
Dialogue: 0,1:26:25.18,1:26:29.47,Default,,0,0,0,,Lúc đó, trong đầu tôi\N đã nghĩ chẳng muốn đi đâu nữa.
Dialogue: 0,1:26:30.39,1:26:32.23,Default,,0,0,0,,Rằng ước gì có thể ở lại đây mãi mãi.
Dialogue: 0,1:26:33.27,1:26:34.39,Default,,0,0,0,,Đó là những gì tôi nghĩ.
Dialogue: 0,1:26:35.85,1:26:36.98,Default,,0,0,0,,Nhưng.
Dialogue: 0,1:26:38.02,1:26:39.57,Default,,0,0,0,,cậu đã ra đi!
Dialogue: 0,1:26:41.40,1:26:43.65,Default,,0,0,0,,Cậu đã tiến bước!
Dialogue: 0,1:26:44.40,1:26:46.66,Default,,0,0,0,,Hãy khiến tôi tin tưởng vào nó!
Dialogue: 0,1:26:47.32,1:26:48.91,Default,,0,0,0,,Tôi là cậu mà nhỉ?
Dialogue: 0,1:26:49.58,1:26:51.58,Default,,0,0,0,,Vậy thì hãy làm tôi tin vào nó đi!
Dialogue: 0,1:26:52.25,1:26:56.42,Default,,0,0,0,,Tuy có nhiều chuyện không\N suôn sẻ nhưng tương lai
Dialogue: 0,1:26:58.92,1:27:01.59,Default,,0,0,0,,dù có trở thành cậu thì tôi nghĩ cũng không sao.
Dialogue: 0,1:27:04.26,1:27:05.93,Default,,0,0,0,,Hãy khiến tôi tin tưởng vào điều đó đi!
Dialogue: 0,1:27:09.35,1:27:10.43,Default,,0,0,0,,Tôi.
Dialogue: 0,1:27:12.85,1:27:14.27,Default,,0,0,0,,Bỏ đi!
Dialogue: 0,1:27:14.27,1:27:15.60,Default,,0,0,0,,Shin!
Dialogue: 0,1:27:25.28,1:27:27.61,Default,,0,0,0,,Cậu làm gì vậy?
Dialogue: 0,1:27:28.95,1:27:30.62,Default,,0,0,0,,Tôi sẽ đi!
Dialogue: 0,1:27:32.49,1:27:35.66,Default,,0,0,0,,Tôi nói là sẽ đi!
Dialogue: 0,1:27:38.92,1:27:45.09,Default,,0,0,0,,Cậu cứ ở đó và trở thành một tên già say xỉn đi!
Dialogue: 0,1:27:45.09,1:27:46.42,Default,,0,0,0,,Tại sao?
Dialogue: 0,1:27:46.42,1:27:55.22,Default,,0,0,0,,Thời gian của anh đã ngừng lại nhưng cảm\N xúc với Akane thì không bao giờ thay đổi!
Dialogue: 0,1:27:56.35,1:28:03.11,Default,,0,0,0,,Đừng hòng anh mày chịu thua ở đây!
Dialogue: 0,1:28:06.15,1:28:07.57,Default,,0,0,0,,A-Ao?
Dialogue: 0,1:28:07.78,1:28:09.28,Default,,0,0,0,,Em cũng sẽ không thua!
Dialogue: 0,1:28:09.28,1:28:14.33,Default,,0,0,0,,Em sẽ không thua cảm xúc của Akane!
Dialogue: 0,1:28:21.29,1:28:24.75,Default,,0,0,0,,Em nói anh không được chạm vào em mà?
Dialogue: 0,1:28:25.71,1:28:30.09,Default,,0,0,0,,Im đi!
Dialogue: 0,1:28:54.95,1:28:56.29,Default,,0,0,0,,Đau!
Dialogue: 0,1:29:00.50,1:29:01.54,Default,,0,0,0,,Đây.
Dialogue: 0,1:29:01.83,1:29:02.92,Default,,0,0,0,,Em ổn chứ?
Dialogue: 0,1:29:02.92,1:29:04.04,Default,,0,0,0,,Vâng.
Dialogue: 0,1:29:04.50,1:29:05.88,Default,,0,0,0,,Cái quái gì thế?
Dialogue: 0,1:29:05.88,1:29:09.01,Default,,0,0,0,,Vậy bọn này đi đây.
Dialogue: 0,1:29:09.51,1:29:11.38,Default,,0,0,0,,Chú già tính sao?
Dialogue: 0,1:29:12.18,1:29:14.51,Default,,0,0,0,,Tính sao á.
Dialogue: 0,1:29:15.01,1:29:15.97,Default,,0,0,0,,Tôi.
Dialogue: 0,1:29:15.97,1:29:17.22,Default,,0,0,0,,Đi thôi, Ao!
Dialogue: 0,1:29:17.47,1:29:18.93,Default,,0,0,0,,Hả? Cái...
Dialogue: 0,1:29:18.93,1:29:20.23,Default,,0,0,0,,Này! Cậu...
Dialogue: 0,1:29:24.52,1:29:27.23,Default,,0,0,0,,Chỉ toàn làm những gì mình thích!
Dialogue: 0,1:29:29.82,1:29:32.41,Default,,0,0,0,,Khoan đã Shinno!
Dialogue: 0,1:29:33.03,1:29:34.41,Default,,0,0,0,,Nhanh quá!
Dialogue: 0,1:29:36.03,1:29:37.24,Default,,0,0,0,,Này!
Dialogue: 0,1:29:37.54,1:29:39.75,Default,,0,0,0,,Đi thôi! Đi thôi!
Dialogue: 0,1:29:45.38,1:29:48.92,Default,,0,0,0,,Chờ anh nhé Akane!
Dialogue: 0,1:29:54.64,1:29:56.97,Default,,0,0,0,,Bay? Cái quái gì thế?
Dialogue: 0,1:29:56.97,1:29:58.93,Default,,0,0,0,,Tự nhiên đâu ra vậy?
Dialogue: 0,1:30:04.35,1:30:06.73,Default,,0,0,0,,Tuyệt ghê! Thế này là thế nào?
Dialogue: 0,1:30:06.81,1:30:10.11,Default,,0,0,0,,Em cũng muốn hỏi anh đó!
Dialogue: 0,1:30:11.40,1:30:15.11,Default,,0,0,0,,Gần đây không có chỗ bắt taxi à? \NMiền quê khốn kiếp!
Dialogue: 0,1:30:36.39,1:30:41.35,Default,,0,0,0,,Khi anh nhìn bức ảnh đó, anh đã hiểu ra nhiều thứ.
Dialogue: 0,1:30:41.56,1:30:42.81,Default,,0,0,0,,Là gì?
Dialogue: 0,1:30:43.31,1:30:50.82,Default,,0,0,0,,Lúc đó, cậu ta phải niêm phong mọi thứ \Nvào bên trong để có thể tiến bước.
Dialogue: 0,1:30:50.82,1:30:53.82,Default,,0,0,0,,Nhưng giờ cậu ta đã quyết định đối đầu với nó lần nữa
Dialogue: 0,1:31:07.08,1:31:13.42,Default,,0,0,0,,đừng để những cảm xúc\N giấu bên trong chỉ toàn là tiếc nuối.
Dialogue: 0,1:31:14.67,1:31:20.93,Default,,0,0,0,,Chúng tôi không thể để bất cứ chiếc xe \Nnào đi tiếp đến khi xác nhận an toàn.
Dialogue: 0,1:31:20.93,1:31:22.59,Default,,0,0,0,,Anh nên chờ ở ga gần nhất!
Dialogue: 0,1:31:22.59,1:31:23.95,Default,,0,0,0,,Bỏ đi!
Dialogue: 0,1:31:24.02,1:31:25.52,Default,,0,0,0,,Đây, giữ lấy tiền thừa.
Dialogue: 0,1:31:26.06,1:31:27.02,Default,,0,0,0,,Này!
Dialogue: 0,1:31:27.40,1:31:28.85,Default,,0,0,0,,Chỉ cấm xe thôi mà?
Dialogue: 0,1:31:29.44,1:31:31.86,Default,,0,0,0,,Cậu là Shinno à?
Dialogue: 0,1:31:32.27,1:31:34.69,Default,,0,0,0,,Abo đây.
Dialogue: 0,1:31:35.57,1:31:37.60,Default,,0,0,0,,Lâu không gặp! Cậu-
Dialogue: 0,1:31:37.60,1:31:38.28,Default,,0,0,0,,Xin lỗi!
Dialogue: 0,1:31:38.28,1:31:40.45,Default,,0,0,0,,Tôi đang vội, không rảnh nói chuyện đâu!
Dialogue: 0,1:31:40.45,1:31:44.70,Default,,0,0,0,,Khoan đã! Đi đâu mà vội thế?
Dialogue: 0,1:31:44.70,1:31:46.37,Default,,0,0,0,,Gandhara!
Dialogue: 0,1:31:50.25,1:31:54.21,Default,,0,0,0,,Thế nên anh đã ở đây.
Dialogue: 0,1:31:55.13,1:31:56.22,Default,,0,0,0,,Hối tiếc.
Dialogue: 0,1:31:57.59,1:31:59.55,Default,,0,0,0,,Em cũng biết.
Dialogue: 0,1:32:03.39,1:32:07.31,Default,,0,0,0,,Khi không thể ủng hộ cho cảm xúc của người mình thích,
Dialogue: 0,1:32:09.35,1:32:11.23,Default,,0,0,0,,sẽ khiến ta hối hận rất lâu.
Dialogue: 0,1:32:13.44,1:32:18.90,Default,,0,0,0,,Em biết vì em không thể ủng hộ cho chị AKane.
Dialogue: 0,1:32:19.86,1:32:20.57,Default,,0,0,0,,Ao?
Dialogue: 0,1:32:21.24,1:32:27.75,Default,,0,0,0,,Thế nên em sẽ ủng hộ anh và Shinnosuke.
Dialogue: 0,1:32:34.55,1:32:35.42,Default,,0,0,0,,Gì?
Dialogue: 0,1:32:51.44,1:32:52.77,Default,,0,0,0,,Anh làm gì vậy?
Dialogue: 0,1:32:52.98,1:32:54.15,Default,,0,0,0,,À thì.
Dialogue: 0,1:32:54.15,1:32:58.94,Default,,0,0,0,,Nghe nói em bé mới sinh nếu thổi mạnh vào đó thì nó sẽ ngừng khóc.
Dialogue: 0,1:33:06.79,1:33:08.12,Default,,0,0,0,,Cái gì lạ vậy.
Dialogue: 0,1:33:08.79,1:33:09.79,Default,,0,0,0,,Im đi.
Dialogue: 0,1:33:14.79,1:33:17.46,Default,,0,0,0,,Bầu trời thật xanh.
Dialogue: 0,1:33:21.47,1:33:27.10,Default,,0,0,0,,Em đã luôn muốn rời khỏi đây. \NNhưng nó thật đẹp.
Dialogue: 0,1:33:30.31,1:33:31.31,Default,,0,0,0,,Ừm.
Dialogue: 0,1:33:34.69,1:33:35.98,Default,,0,0,0,,Phải nhỉ.
Dialogue: 0,1:33:47.49,1:33:48.99,Default,,0,0,0,,Thấy rồi.
Dialogue: 0,1:33:49.50,1:33:52.71,Default,,0,0,0,,Thiệt tình. Mày gây rắc rối lắm đó.
Dialogue: 0,1:33:52.71,1:33:55.33,Default,,0,0,0,,Trong tình hình này mà em...
Dialogue: 0,1:33:56.17,1:33:58.34,Default,,0,0,0,,Đúng là trái tim không biết sợ.
Dialogue: 0,1:34:03.34,1:34:04.68,Default,,0,0,0,,Shinno?
Dialogue: 0,1:34:14.19,1:34:15.19,Default,,0,0,0,,Đây rồi!
Dialogue: 0,1:34:16.90,1:34:18.86,Default,,0,0,0,,Thằng kia đâu?
Dialogue: 0,1:34:19.86,1:34:20.86,Default,,0,0,0,,Akane đâu?
Dialogue: 0,1:34:26.03,1:34:27.20,Default,,0,0,0,,Hiểu rồi.
Dialogue: 0,1:34:27.70,1:34:29.37,Default,,0,0,0,,Thật khó tin nhỉ?
Dialogue: 0,1:34:30.20,1:34:31.62,Default,,0,0,0,,Đúng là anh, Shinno.
Dialogue: 0,1:34:31.62,1:34:33.12,Default,,0,0,0,,Em tin anh à?
Dialogue: 0,1:34:33.12,1:34:36.21,Default,,0,0,0,,Thì anh đang trước mặt em mà?
Dialogue: 0,1:34:37.38,1:34:39.88,Default,,0,0,0,,Đúng là không gì khiến em ngạc nhiên nhỉ.
Dialogue: 0,1:34:40.96,1:34:42.05,Default,,0,0,0,,Nhưng may quá.
Dialogue: 0,1:34:43.26,1:34:44.55,Default,,0,0,0,,Có bóng tối này...
Dialogue: 0,1:34:45.22,1:34:48.05,Default,,0,0,0,,Nếu có ánh sáng thì anh sẽ thấy nếp nhăn của em mất.
Dialogue: 0,1:34:48.93,1:34:51.39,Default,,0,0,0,,Anh sẽ thất vọng đó, Shinno.
Dialogue: 0,1:34:51.39,1:34:54.94,Default,,0,0,0,,Xin lỗi, anh thấy hết rồi.
Dialogue: 0,1:34:54.94,1:34:56.85,Default,,0,0,0,,Cái gì? Khi nào? Ở đâu?
Dialogue: 0,1:34:56.85,1:34:58.23,Default,,0,0,0,,Ở phòng chờ.
Dialogue: 0,1:34:59.11,1:35:02.90,Default,,0,0,0,,Khi em đến gặp Ao và khi mang cơm nắm đến.
Dialogue: 0,1:35:04.11,1:35:05.57,Default,,0,0,0,,Thật hả?
Dialogue: 0,1:35:05.57,1:35:07.74,Default,,0,0,0,,Lại là tảo biển.
Dialogue: 0,1:35:08.91,1:35:12.04,Default,,0,0,0,,Cơm nắm. Anh đã nói thích cá ngừ và mayonaise.
Dialogue: 0,1:35:12.12,1:35:14.25,Default,,0,0,0,,Nhưng lúc nào em cũng làm vị Ao thích.
Dialogue: 0,1:35:15.33,1:35:16.58,Default,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,1:35:16.58,1:35:17.92,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,1:35:19.08,1:35:20.42,Default,,0,0,0,,Giờ thì anh đã hiểu.
Dialogue: 0,1:35:24.13,1:35:27.18,Default,,0,0,0,,"Con ếch trong giếng sẽ không \Nbiết sự rộng lớn của đại dương,
Dialogue: 0,1:35:28.05,1:35:30.85,Default,,0,0,0,,nhưng nó sẽ biết được bầu trời có màu xanh."
Dialogue: 0,1:35:32.72,1:35:34.35,Default,,0,0,0,,Câu nói mà em thích.
Dialogue: 0,1:35:35.23,1:35:36.35,Default,,0,0,0,,Shinno?
Dialogue: 0,1:35:37.23,1:35:39.86,Default,,0,0,0,,Cá ngừ và mayo không thể là rong biển được nhỉ?
Dialogue: 0,1:35:40.40,1:35:42.52,Default,,0,0,0,,Một khi em biết được bầu trời màu xanh...
Dialogue: 0,1:35:49.49,1:35:51.03,Default,,0,0,0,,Con bé đã trở nên dễ thương hơn nhỉ?
Dialogue: 0,1:35:56.00,1:35:57.37,Default,,0,0,0,,Ai mà biết.
Dialogue: 0,1:35:57.75,1:36:04.55,Default,,0,0,0,,Con bé lớn lên nhưng vẫn bất cẩn, không rõ ràng và không thông minh nữa.
Dialogue: 0,1:36:06.01,1:36:08.93,Default,,0,0,0,,Nhưng thẳng thắn như một mũi tên.
Dialogue: 0,1:36:08.93,1:36:13.39,Default,,0,0,0,,Ừm, thẳng thắn và ngu ngốc.
Dialogue: 0,1:36:14.52,1:36:17.06,Default,,0,0,0,,Nó khiến em nhớ đến anh.
Dialogue: 0,1:36:19.02,1:36:20.23,Default,,0,0,0,,Vậy thì tốt.
Dialogue: 0,1:36:21.19,1:36:22.06,Default,,0,0,0,,Rồi!
Dialogue: 0,1:36:22.94,1:36:27.07,Default,,0,0,0,,Em gái em, Ao, là kho báu quý giá nhất với em.
Dialogue: 0,1:36:31.12,1:36:34.58,Default,,0,0,0,,Thật may khi anh đã yêu em.
Dialogue: 0,1:36:39.29,1:36:40.83,Default,,0,0,0,,Không được!
Dialogue: 0,1:36:40.83,1:36:46.13,Default,,0,0,0,,Nó có thể sụp đổ bất cứ khi nào, trừ khi anh có thể bay.
Dialogue: 0,1:36:46.13,1:36:48.59,Default,,0,0,0,,Thả ra, Akane vẫn.
Dialogue: 0,1:36:50.88,1:36:52.34,Default,,0,0,0,,Hai người làm trò gì thế?
Dialogue: 0,1:36:56.22,1:36:57.14,Default,,0,0,0,,Akane! May quá--
Dialogue: 0,1:36:57.14,1:36:58.02,Default,,0,0,0,,Aoi!
Dialogue: 0,1:36:58.64,1:37:00.94,Default,,0,0,0,,Akane, nặng quá.
Dialogue: 0,1:37:00.94,1:37:02.19,Default,,0,0,0,,Nói kì vậy.
Dialogue: 0,1:37:02.19,1:37:03.98,Default,,0,0,0,,Cơ mà chị ổn chứ?
Dialogue: 0,1:37:03.98,1:37:07.03,Default,,0,0,0,,Không có gì đâu! Không cần phải lo.
Dialogue: 0,1:37:07.03,1:37:08.74,Default,,0,0,0,,Chị nói gì thế?
Dialogue: 0,1:37:08.74,1:37:10.82,Default,,0,0,0,,Bọn em lo cho chị lắm đó!
Dialogue: 0,1:37:10.82,1:37:14.95,Default,,0,0,0,,Xin lỗi vì làm em lo lắng, Aoi.
Dialogue: 0,1:37:16.70,1:37:20.46,Default,,0,0,0,,Thiệt tình! Lo lắm đó!
Dialogue: 0,1:37:42.60,1:37:45.02,Default,,0,0,0,,Hả? Một mình quay về?
Dialogue: 0,1:37:45.02,1:37:45.80,Default,,0,0,0,,Ừm.
Dialogue: 0,1:37:46.65,1:37:49.03,Default,,0,0,0,,Tại sao? Mọi người lên đều được mà?
Dialogue: 0,1:37:49.03,1:37:52.65,Default,,0,0,0,,Không không, bốn người trong xe chị thì chật lắm.
Dialogue: 0,1:37:53.03,1:37:54.91,Default,,0,0,0,,Em sẽ bắt taxi.
Dialogue: 0,1:37:55.20,1:37:57.49,Default,,0,0,0,,Vậy thì anh cũng.
Dialogue: 0,1:37:57.87,1:37:59.41,Default,,0,0,0,,Ba người đi đi.
Dialogue: 0,1:38:00.20,1:38:01.25,Default,,0,0,0,,Aoi?
Dialogue: 0,1:38:03.54,1:38:05.75,Default,,0,0,0,,Gặp anh sau, Shinno.
Dialogue: 0,1:38:07.34,1:38:08.42,Default,,0,0,0,,Ờ.
Dialogue: 0,1:38:08.80,1:38:09.92,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,1:38:10.21,1:38:11.42,Default,,0,0,0,,ngôi sao tròng mắt.
Dialogue: 0,1:38:27.15,1:38:27.94,Default,,0,0,0,,Ủa?
Dialogue: 0,1:38:29.27,1:38:30.28,Default,,0,0,0,,Tên này
Dialogue: 0,1:38:31.11,1:38:32.28,Default,,0,0,0,,đang ngủ à?
Dialogue: 0,1:38:33.95,1:38:36.95,Default,,0,0,0,,Có sao đâu? Anh ấy đã rất mệt mà.
Dialogue: 0,1:38:42.50,1:38:43.62,Default,,0,0,0,,Anh.
Dialogue: 0,1:38:45.62,1:38:48.96,Default,,0,0,0,,Tên đó nói rằng anh đã tiến bước.
Dialogue: 0,1:38:51.13,1:38:53.97,Default,,0,0,0,,Nhưng anh vẫn chỉ đang ở giữa chừng.
Dialogue: 0,1:38:55.80,1:38:58.47,Default,,0,0,0,,Anh nhớ rằng mình chỉ đang ở giữa chừng.
Dialogue: 0,1:39:00.14,1:39:04.48,Default,,0,0,0,,Thế nên anh không muốn bỏ cuộc.
Dialogue: 0,1:39:06.19,1:39:07.15,Default,,0,0,0,,Ừm.
Dialogue: 0,1:39:08.98,1:39:12.40,Default,,0,0,0,,Và anh cũng không từ bỏ em đâu.
Dialogue: 0,1:39:23.16,1:39:24.96,Default,,0,0,0,,Ba chúng ta à?
Dialogue: 0,1:39:27.58,1:39:33.51,Default,,0,0,0,,Hiểu rồi. Aoi đã bằng tuổi chúng ta ngày đó.
Dialogue: 0,1:39:44.48,1:39:49.02,Default,,0,0,0,,Lần tới có lẽ em nên thử làm cơm nắm với mayo và cá ngừ vậy.
Dialogue: 0,1:39:52.23,1:39:53.86,Default,,0,0,0,,Nè, vậy tức là...
Dialogue: 0,1:39:55.19,1:39:56.03,Default,,0,0,0,,Ủa?
Dialogue: 0,1:40:24.31,1:40:27.02,Default,,0,0,0,,Em không có khóc!
Dialogue: 0,1:40:53.00,1:40:54.25,Default,,0,0,0,,Em không có
Dialogue: 0,1:40:57.09,1:40:58.26,Default,,0,0,0,,khóc.
Dialogue: 0,1:41:04.64,1:41:06.10,Default,,0,0,0,,Shinno ngu ngốc!
Dialogue: 0,1:41:32.21,1:41:33.46,Default,,0,0,0,,Bầu trời
Dialogue: 0,1:41:35.29,1:41:36.80,Default,,0,0,0,,lại một màu xanh khốn kiếp.
Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0,0,0,,
